/* pages/pay/pay.wxss */
.pay-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 20rpx 0 40rpx;
}

/* 付费卡片 */
.pay-content {
  padding: 0 32rpx;
}
.pay-card {
  background: var(--card);
  border-radius: 40rpx;
  padding: 48rpx;
  text-align: center;
  box-shadow: var(--shadow-lg);
  border: 2rpx solid var(--border);
}
.pay-card-header {
  margin-bottom: 32rpx;
}
.pay-card-title {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--ink);
  display: block;
  line-height: 1;
}
.pay-card-sub {
  font-size: 32rpx;
  color: var(--text-l);
  display: block;
  margin-top: 8rpx;
  font-weight: 600;
}

/* 权益 */
.pay-benefits {
  text-align: left;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: var(--rose-50);
  border-radius: 24rpx;
}
.pay-benefit-item {
  font-size: 28rpx;
  color: var(--text);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--rose-200);
}
.pay-benefit-item:last-child {
  border-bottom: none;
}

/* 按钮 */
.pay-btn {
  width: 100%;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}

.pay-note {
  font-size: 24rpx;
  color: var(--text-l);
  letter-spacing: 1rpx;
}

/* 链接 */
.pay-links {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  margin-top: 32rpx;
}
.pay-link {
  font-size: 26rpx;
  color: var(--rose-600);
  text-decoration: underline;
}
.pay-link-activation {
  color: #f59e0b;
  font-weight: 600;
}
.pay-link-divider {
  color: #e5e7eb;
  font-size: 24rpx;
}

/* 激活码输入区 */
.pay-activation-area {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--rose-50);
  border: 2rpx solid var(--border);
}
.pay-activation-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 16rpx;
}
.pay-activation-row {
  display: flex;
  gap: 16rpx;
}
.pay-activation-input {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 36rpx;
  letter-spacing: 8rpx;
  text-align: center;
  background: var(--card);
}
.pay-activation-btn {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
  border: none;
  white-space: nowrap;
}
.pay-activation-msg {
  font-size: 24rpx;
  color: var(--rose-500);
  text-align: center;
  margin-top: 12rpx;
}

/* 须知弹窗 */
.notice-content {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
}
.notice-section {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}
.notice-bold {
  font-weight: 700;
  color: var(--ink);
}
.notice-item {
  padding-left: 24rpx;
  margin-bottom: 6rpx;
}
