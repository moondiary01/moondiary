/* pages/review/review.wxss */
.review-page {
  padding: 20rpx 0 40rpx;
  background: var(--bg);
  min-height: 100vh;
}

.review-tip {
  text-align: center;
  font-size: 25rpx;
  color: var(--text-l);
  padding: 20rpx 32rpx 10rpx;
  line-height: 1.6;
}

/* 周卡片 — HTML: padding 18px→36rpx */
.review-card {
  margin-bottom: 20rpx;
  padding: 36rpx;
}
.review-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.review-week-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--rose-600);
}
.review-week-date {
  font-size: 26rpx;
  color: var(--text-l);
}

/* 统计网格 */
.review-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.review-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.6);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  min-width: 120rpx;
}
.review-stat-label {
  font-size: 22rpx;
  color: var(--text-l);
  margin-bottom: 4rpx;
}
.review-stat-val {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--rose-600);
}
.review-stat-val.red {
  color: var(--rose-500);
}
.review-stat-val.mint {
  color: var(--mint);
}
.review-stat-period {
  color: var(--rose-600) !important;
}
.review-stat-water {
  color: var(--sky) !important;
}

/* 文本框 */
.review-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  border: 2rpx solid var(--border);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text);
  background: var(--card);
  box-sizing: border-box;
  line-height: 1.6;
}

/* 保存按钮 */
.review-save-btn {
  margin-top: 16rpx;
  width: 100%;
}

/* 导出区域 */
.review-export-bar {
  padding: 20rpx 32rpx 40rpx;
  text-align: center;
}
.review-export-bar .btn {
  width: 100%;
  font-size: 30rpx;
  padding: 28rpx;
}

/* 空状态 */
.review-empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--text-l);
  font-size: 28rpx;
}
