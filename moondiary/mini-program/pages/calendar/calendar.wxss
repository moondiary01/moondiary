/* pages/calendar/calendar.wxss */
.calendar-page {
  padding-bottom: 40rpx;
}

/* 月份导航 */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  padding: 20rpx 0;
}
.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ec4899;
  background: #fce7f3;
  border-radius: 50%;
}
.cal-nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
}

/* 表头 */
.cal-header {
  display: flex;
  margin: 0 16rpx;
}
.cal-hcell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #a8a29e;
  padding: 10rpx 0;
  font-weight: 600;
}

/* 日历网格 */
.cal-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 16rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.cal-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 6rpx 2rpx;
  position: relative;
  border-radius: 12rpx;
}
.cal-empty {
  background: transparent;
}
.cal-day-num {
  font-size: 26rpx;
  color: #1c1917;
  font-weight: 600;
  margin-top: 4rpx;
}
.cal-today {
  background: #f5f5f4;
}
.cal-today .cal-day-num {
  color: #ec4899;
}
.cal-period {
  background: #fce7f3;
}
.cal-period .cal-day-num {
  color: #ec4899;
}
.cal-period-predict {
  background: #fdf2f8;
}
.cal-ovulation {
  background: #fefce8;
}
.cal-exercise {
  background: #dcfce7;
}
.cal-exercise .cal-day-num {
  color: #16a34a;
}

/* 日标记 */
.cal-day-marks {
  display: flex;
  gap: 2rpx;
  margin-top: 2rpx;
}
.cal-mark {
  font-size: 20rpx;
}

/* 体重波动 */
.cal-day-weight {
  display: flex;
  align-items: center;
  gap: 1rpx;
  margin-top: 2rpx;
}
.weight-arrow {
  font-size: 18rpx;
  font-weight: 700;
}
.arrow-up { color: #ef4444; }
.arrow-down { color: #16a34a; }
.weight-change-val {
  font-size: 18rpx;
}
.change-up { color: #ef4444; }
.change-down { color: #16a34a; }

/* 图例 */
.cal-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin: 20rpx 24rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}
.cal-legend .legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #78716c;
}
.lg-period { background: #fce7f3; width: 20rpx; height: 20rpx; border-radius: 4rpx; }
.lg-ovulation { background: #fefce8; width: 20rpx; height: 20rpx; border-radius: 4rpx; }
.lg-predict { background: #fdf2f8; width: 20rpx; height: 20rpx; border-radius: 4rpx; }
.lg-exercise { background: #dcfce7; width: 20rpx; height: 20rpx; border-radius: 4rpx; }
.legend-emoji { font-size: 24rpx; }

/* 详情弹窗 */
.detail-modal {
  max-height: 85vh;
}
.detail-section {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f4;
}
.detail-section:last-child {
  border-bottom: none;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.detail-label {
  font-size: 26rpx;
  color: #78716c;
}
.detail-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1917;
}
.detail-text {
  font-size: 28rpx;
  color: #1c1917;
  line-height: 1.6;
  margin-top: 8rpx;
  padding: 16rpx;
  background: #faf5f9;
  border-radius: 12rpx;
}
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}
.detail-actions .btn {
  flex: 1;
}
