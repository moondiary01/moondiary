.my-detail-page { min-height: 100vh; background: #faf5f9; }
.my-detail-header { display: flex; align-items: center; padding: 24rpx 32rpx; background: #fff; border-bottom: 2rpx solid #f5f5f4; position: sticky; top: 0; z-index: 10; }
.my-detail-back { font-size: 48rpx; color: #44403c; padding: 8rpx 16rpx; margin-left: -8rpx; line-height: 1; }
.my-detail-title { font-size: 36rpx; font-weight: 700; color: #1a1025; flex: 1; text-align: center; margin-right: 64rpx; }
.my-detail-body { padding: 80rpx 48rpx; text-align: center; min-height: 60vh; }
.my-detail-placeholder { display: flex; flex-direction: column; align-items: center; }
.ph-circle { width: 96rpx; height: 96rpx; border-radius: 50%; background: #f5f5f4; margin-bottom: 24rpx; }
.ph-text { font-size: 30rpx; color: #a8a29e; }
