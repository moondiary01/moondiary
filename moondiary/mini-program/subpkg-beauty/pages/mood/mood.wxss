/* subpkg-beauty/pages/mood/mood.wxss */

.mood-page {
  min-height: 100vh;
  background: #faf5f9;
  padding-bottom: 180rpx;
}

/* ===== 卡片通用 ===== */
.mood-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid transparent;
}

/* 不同卡片左边框色标 */
.mood-card:nth-child(1) { border-left-color: #8b5cf6; }  /* 当前状态 - 紫 */
.mood-card:nth-child(2) { border-left-color: #ec4899; }  /* 今日心情 - 粉 */
.mood-card:nth-child(3) { border-left-color: #a8a29e; }  /* 心情日记 - 灰 */
.mood-card:nth-child(4) { border-left-color: #f59e0b; }  /* 感恩日记 - 琥珀 */
.mood-card:nth-child(5) { border-left-color: #10b981; }  /* 冥想打卡 - 绿 */
.mood-card:nth-child(6) { border-left-color: #06b6d4; }  /* 冥想音乐 - 青 */
.mood-card:nth-child(7) { border-left-color: #6366f1; }  /* 自律打卡 - 靛 */
.mood-card:nth-child(8) { border-left-color: #f59e0b; }  /* 心情日历 - 琥珀 */
.mood-card:nth-child(9) { border-left-color: #0ea5e9; }  /* 日历照片 - 蓝 */

.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.card-title-icon {
  font-size: 36rpx;
}

.card-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
  letter-spacing: 1rpx;
}

/* ===== 当前状态 ===== */
.status-date {
  font-size: 26rpx;
  color: #a8a29e;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.status-input {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fdf4ff, #fef3f8);
  font-size: 30rpx;
  color: #44403c;
  border: none;
  font-weight: 500;
}

/* ===== 心情表情 ===== */
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.emoji-item {
  width: calc(20% - 13rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: #f5f5f4;
  gap: 8rpx;
  transition: all 0.2s;
}

.emoji-icon {
  width: 80rpx;
  height: 80rpx;
}

.emoji-label {
  font-size: 22rpx;
  color: #78716c;
  font-weight: 500;
}

.emoji-active {
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.18);
  transform: scale(1.05);
}

.emoji-active .emoji-label {
  color: #8b5cf6;
  font-weight: 600;
}

/* ===== 心情日记 ===== */
.diary-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 240rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
  font-size: 28rpx;
  color: #44403c;
  line-height: 1.7;
  border: none;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #c8c4c0;
  margin-top: 12rpx;
}

/* ===== 冥想打卡 ===== */
.meditation-checkin {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.meditation-checkin .check-item {
  align-self: flex-start;
  padding: 18rpx 28rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
  font-size: 28rpx;
  color: #57534e;
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition: all 0.2s;
}

.meditation-checkin .check-item-active {
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  color: #8b5cf6;
  font-weight: 600;
}

.check-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d6d3d1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
}

.check-circle-active {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  border-color: transparent;
}

.check-icon {
  font-size: 22rpx;
  color: #fff;
  font-weight: 700;
}

.meditation-minutes {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
}

.minutes-label {
  font-size: 28rpx;
  color: #8b5cf6;
  font-weight: 600;
}

.minutes-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.minutes-input {
  width: 100rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: #fff;
  font-size: 32rpx;
  font-weight: 700;
  color: #8b5cf6;
  text-align: center;
  border: none;
}

.minutes-unit {
  font-size: 26rpx;
  color: #8b5cf6;
  font-weight: 500;
}

/* ===== 冥想音乐 ===== */
.music-category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.music-category-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx;
}

.music-cat-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 100rpx;
  background: #f5f5f4;
  transition: all 0.2s;
}

.music-cat-active {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.3);
}

.music-cat-icon {
  font-size: 28rpx;
}

.music-cat-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #78716c;
}

.music-cat-active .music-cat-label {
  color: #fff;
  font-weight: 600;
}

.music-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.music-track {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #f5f5f4;
  transition: all 0.2s;
}

.track-active {
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.12);
}

.track-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.track-active .track-icon-wrap {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
}

.track-play-icon {
  font-size: 28rpx;
  color: #a8a29e;
}

.track-active .track-play-icon {
  color: #fff;
}

.track-playing-icon {
  font-size: 28rpx;
}

.track-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.track-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
}

.track-active .track-title {
  color: #8b5cf6;
}

.track-duration {
  font-size: 24rpx;
  color: #a8a29e;
}

/* ===== 自律打卡 ===== */
.discipline-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.discipline-item {
  width: calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
  gap: 8rpx;
  position: relative;
  transition: all 0.2s;
}

.discipline-active {
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  box-shadow: 0 2rpx 12rpx rgba(139, 92, 246, 0.12);
}

.discipline-label {
  font-size: 24rpx;
  color: #78716c;
  font-weight: 500;
}

.discipline-active .discipline-label {
  color: #8b5cf6;
  font-weight: 600;
}

.discipline-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #d6d3d1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.discipline-check-on {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  border-color: transparent;
}

/* ===== 照片区域 ===== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f5f5f4;
  position: relative;
}

.photo-thumb image {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.photo-add-btn {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  background: #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed #d6d3d1;
}

.photo-add-icon {
  font-size: 56rpx;
  color: #c8c4c0;
  font-weight: 300;
}

/* ===== 保存按钮 ===== */
.save-btn-wrapper {
  padding: 20rpx 24rpx 40rpx;
}

.save-btn {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-weight: 700;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.3);
}

/* ===== 迷你播放器 ===== */
.mini-player {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(139, 92, 246, 0.12);
  box-shadow: 0 -4rpx 20rpx rgba(139, 92, 246, 0.08);
  z-index: 100;
}

.player-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.player-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.player-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f5f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8b5cf6;
}

.player-btn-main {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.3);
}

.player-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #a8a29e;
  margin-left: 12rpx;
}

/* ===== 感恩日记卡片 ===== */
.gratitude-card {
  background: linear-gradient(135deg, rgba(254,243,199,0.3), rgba(254,215,170,0.2));
  border: 2rpx solid rgba(251,191,36,0.15);
}
.gratitude-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.gratitude-input {
  width: 100%;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(251,191,36,0.3);
  border-radius: 14rpx;
  font-size: 28rpx;
  background: rgba(255,255,255,0.7);
  box-sizing: border-box;
}
.gratitude-input::placeholder {
  color: #a8a29e;
}

/* ===== 心情日历 ===== */
.mood-calendar-card {
  border-left-color: #f59e0b !important;
}

.cal-hint {
  font-size: 22rpx;
  color: #a8a29e;
  margin-bottom: 16rpx;
  text-align: center;
}

.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #8b5cf6;
  font-weight: 700;
}

.cal-nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1917;
}

.cal-header {
  display: flex;
}

.cal-hcell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #a8a29e;
  padding: 8rpx 0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  position: relative;
  box-sizing: border-box;
}

.cal-empty { background: transparent; }

.cal-today {
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  font-weight: 700;
}

.cal-has-record {
  background: rgba(139,92,246,0.04);
}

.cal-day-num {
  font-size: 24rpx;
  font-weight: 500;
  color: #44403c;
}

.cal-today .cal-day-num {
  color: #8b5cf6;
  font-weight: 700;
}

.cal-day-marks {
  display: flex;
  gap: 2rpx;
  margin-top: 2rpx;
  min-height: 20rpx;
  align-items: center;
}

.cal-mark {
  font-size: 16rpx;
  line-height: 1;
}

.cal-mark-photo {
  font-size: 18rpx;
  position: absolute;
  top: 2rpx;
  left: 2rpx;
}

.cal-mark-done {
  color: #8b5cf6;
  font-weight: 700;
  font-size: 18rpx;
}

.cal-mark-mood {
  width: 32rpx;
  height: 32rpx;
}

.cal-mark-gratitude {
  color: #f59e0b;
  font-size: 18rpx;
}

.cal-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f4;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #a8a29e;
}

.legend-emoji {
  font-size: 22rpx;
}

.mood-dot { color: #8b5cf6; font-weight: 700; }
.gratitude-dot { color: #f59e0b; }

/* ===== 日历详情弹窗 ===== */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-modal {
  width: 80%;
  max-height: 75vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
}

.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f4;
}

.detail-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 1rpx;
}

.detail-close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #78716c;
}

/* 详情卡片 */
.detail-card {
  margin-bottom: 16rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  border-left: 6rpx solid transparent;
}

.detail-card-pink { border-left-color: #ec4899; }
.detail-card-purple { border-left-color: #8b5cf6; }
.detail-card-gray { border-left-color: #a8a29e; }
.detail-card-green { border-left-color: #10b981; }
.detail-card-amber { border-left-color: #f59e0b; }

.detail-card-title {
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.detail-card-pink .detail-card-title { color: #ec4899; }
.detail-card-purple .detail-card-title { color: #8b5cf6; }
.detail-card-gray .detail-card-title { color: #a8a29e; }
.detail-card-green .detail-card-title { color: #10b981; }
.detail-card-amber .detail-card-title { color: #f59e0b; }

/* 心情展示 */
.mood-detail-display {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.mood-detail-emoji {
  width: 80rpx;
  height: 80rpx;
}

.mood-detail-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
}

/* 状态/日记文本 */
.detail-status-text {
  font-size: 28rpx;
  color: #44403c;
  line-height: 1.6;
}

.detail-diary-text {
  font-size: 28rpx;
  color: #44403c;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* 打卡标签 */
.detail-mini-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail-mini-tag {
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.detail-mini-tag.mini-on {
  background: rgba(16,185,129,0.08);
  color: #059669;
}

/* 感恩日记详情 */
.gratitude-detail-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 6rpx 0;
}

.gratitude-detail-num {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(245,158,11,0.12);
  color: #d97706;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gratitude-detail-text {
  font-size: 28rpx;
  color: #44403c;
  line-height: 1.5;
  flex: 1;
}

/* 照片行 */
.detail-photo-section {
  margin-bottom: 20rpx;
}

.detail-photo-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.detail-photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f5f5f4;
}

/* 弹窗按钮 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.detail-actions .btn {
  flex: 1;
  font-size: 30rpx;
  padding: 18rpx 0;
  border-radius: 100rpx;
  text-align: center;
}

.btn-outline {
  background: #f5f5f4;
  color: #78716c;
  border: none;
}

/* 自定义打卡输入 */
.custom-check-input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 26rpx;
  margin-top: 20rpx;
  background: #fafaf9;
  color: #78716c;
}
