/* components/pay-modal/pay-modal.wxss — 试用到期购买弹窗 */

/* 遮罩层 — 固定居中，不滚动，阻止底部页面滑动 */
.overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(28,25,23,0.4);
  display: flex; align-items: center; justify-content: center;
  z-index: 10000;
  backdrop-filter: blur(12rpx);
  overflow: hidden;
}

/* 弹窗外框 — 固定高度，内部 scroll-view 滚动 */
.modal-box {
  width: 840rpx;
  border-radius: 48rpx;
  background: transparent;
  box-shadow: 0 48rpx 160rpx rgba(124,58,237,0.35), 0 16rpx 48rpx rgba(0,0,0,0.15);
  overflow: hidden;
}

/* scroll-view 滚动区域 — 必须固定高度才能滚动 */
.pm-scroll {
  height: 90vh;
  width: 100%;
}

/* ===== 顶部渐变区 ===== */
.pm-top {
  background: linear-gradient(160deg, #1a1025 0%, #2d1b4e 35%, #4c1d6b 65%, #7c3aed 100%);
  padding: 72rpx 56rpx 64rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.pm-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.pm-glow-pink {
  top: -60rpx; right: -40rpx;
  width: 240rpx; height: 240rpx;
  background: radial-gradient(circle, rgba(236,72,153,0.25), transparent 70%);
}
.pm-glow-gold {
  bottom: -80rpx; left: -30rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(245,158,11,0.15), transparent 70%);
}
.pm-glow-center {
  top: 50%; left: 50%;
  transform: translate(-50%,-50%);
  width: 300rpx; height: 300rpx;
  background: radial-gradient(circle, rgba(139,92,246,0.12), transparent 60%);
}
.pm-icon {
  position: relative; z-index: 1;
  font-size: 96rpx;
  display: block;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 8rpx 24rpx rgba(245,158,11,0.4));
}
.pm-title {
  position: relative; z-index: 1;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  display: block;
  margin-bottom: 8rpx;
}
.pm-sub {
  position: relative; z-index: 1;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 1rpx;
  display: block;
}

/* ===== 底部白色内容区 ===== */
.pm-body {
  background: #fff;
  padding: 36rpx 32rpx 32rpx;
}

/* 权益清单 */
.pm-benefits {
  display: flex; flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.pm-benefit {
  display: flex; align-items: center;
  gap: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(139,92,246,0.05), rgba(139,92,246,0.02));
}
.pm-bf-text {
  flex: 1;
  display: flex; flex-direction: column;
  gap: 4rpx;
}
.pm-bf-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1917;
}
.pm-bf-desc {
  font-size: 22rpx;
  color: #a8a29e;
}

/* 价格卡 */
.pm-price-card {
  background: linear-gradient(135deg, #1a1025, #2d1b4e);
  border-radius: 28rpx;
  padding: 28rpx 28rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.pm-price-glow {
  position: absolute;
  top: -24rpx; right: -24rpx;
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245,158,11,0.3), transparent 70%);
  pointer-events: none;
}
.pm-price-inner {
  position: relative; z-index: 1;
}
.pm-price-row {
  display: flex; align-items: baseline; justify-content: center;
  gap: 4rpx;
  margin-bottom: 6rpx;
}
.pm-price-yuan {
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  font-weight: 500;
}
.pm-price-num {
  font-size: 76rpx;
  font-weight: 900;
  color: #fbbf24;
  line-height: 1;
  letter-spacing: -2rpx;
}
.pm-price-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,0.55);
  display: block;
  margin-bottom: 18rpx;
}
.pm-buy-btn {
  width: 100%;
  padding: 22rpx 0;
  border: none;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #1a1025;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  box-shadow: 0 12rpx 48rpx rgba(245,158,11,0.4);
}

/* 购买须知 + 隐私协议 */
.pm-links {
  display: flex; justify-content: center; align-items: center;
  gap: 28rpx;
}

/* 勾选协议 */
.pm-agree-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 20rpx;
}
.pm-agree-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  flex-shrink: 0;
}
.pm-agree-circle.checked {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  border-color: transparent;
}
.pm-agree-tick {
  color: #fff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
}
.pm-agree-text {
  font-size: 24rpx;
  color: #78716c;
}
.pm-agree-link {
  font-size: 24rpx;
  color: #8b5cf6;
  font-weight: 500;
}
.pm-link {
  font-size: 24rpx;
  color: #8b5cf6;
  font-weight: 500;
}
.pm-link-divider {
  color: #e5e7eb;
  font-size: 20rpx;
}

/* 激活码区域 */
.pm-activation-area {
  margin-bottom: 24rpx;
}
.pm-activation-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 10rpx;
}
.pm-activation-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.pm-activation-input {
  flex: 1;
  padding: 22rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  text-align: center;
  color: var(--rose-600);
  background: var(--rose-50);
}
.pm-activation-btn {
  flex-shrink: 0;
  padding: 22rpx 32rpx;
  border: none;
  border-radius: 20rpx;
  background: var(--grad-hero);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.pm-activation-msg {
  font-size: 22rpx;
  color: var(--rose-500);
  margin-top: 8rpx;
  text-align: center;
  font-weight: 600;
}

/* 稍后再说 */
.pm-later {
  text-align: center;
  margin-top: 20rpx;
}
.pm-later-text {
  font-size: 24rpx;
  color: #c4b5fd;
}

/* 管理员预览：返回按钮 */
.pm-admin-back {
  text-align: center;
  margin-top: 16rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid #f3f4f6;
}
.pm-admin-back-text {
  font-size: 26rpx;
  color: #8b5cf6;
  font-weight: 600;
}
