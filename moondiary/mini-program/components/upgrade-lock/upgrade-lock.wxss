/* components/upgrade-lock/upgrade-lock.wxss */

/* ===== 遮罩层 ===== */
.ul-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ul-overlay-sub {
  z-index: 10001;
}

/* ===== 主弹窗 ===== */
.ul-modal {
  width: 600rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: transparent;
  box-shadow: 0 32rpx 80rpx rgba(124, 58, 237, 0.35), 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

/* ===== Header: 深色渐变 ===== */
.ul-header {
  background: linear-gradient(160deg, #1a1025 0%, #2d1b4e 40%, #4c1d6b 70%, #7c3aed 100%);
  padding: 72rpx 56rpx 56rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

/* 光晕装饰 */
.ul-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ul-glow-tr {
  top: -120rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(236, 72, 153, 0.25) 0%, transparent 70%);
}

.ul-glow-bl {
  bottom: -60rpx;
  left: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%);
}

.ul-glow-center {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.12) 0%, transparent 60%);
}

.ul-header-inner {
  position: relative;
  z-index: 1;
}

.ul-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.3);
}

.ul-subtitle {
  color: rgba(255, 255, 255, 0.55);
  font-size: 22rpx;
  letter-spacing: 8rpx;
  margin-top: 12rpx;
}

/* ===== Body ===== */
.ul-body {
  background: #fff;
  padding: 40rpx 48rpx 32rpx;
  position: relative;
  margin-top: -24rpx;
  border-radius: 40rpx 40rpx 0 0;
  z-index: 2;
}

/* ===== 栏目入口（预览） ===== */
.ul-section-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(139, 92, 246, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.04);
}

.ul-section-skincare {
  background: linear-gradient(135deg, #faf5ff, #fdf2f8);
}

.ul-section-mood {
  background: linear-gradient(135deg, #fdf2f8, #fff1f2);
  border-color: rgba(236, 72, 153, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.04);
}

.ul-section-info {
  flex: 1;
  min-width: 0;
}

.ul-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1917;
}

.ul-section-desc {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 4rpx;
}

.ul-section-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
}

.ul-section-arrow-purple {
  background: rgba(139, 92, 246, 0.1);
  color: #8b5cf6;
}

.ul-section-arrow-pink {
  background: rgba(236, 72, 153, 0.1);
  color: #ec4899;
}

/* ===== 锁定信息区 ===== */
.ul-lock-msg {
  text-align: center;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #fffbeb, #fef2f2);
  border-radius: 32rpx;
  border: 1px solid rgba(251, 191, 36, 0.2);
}

.ul-lock-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.ul-lock-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #92400e;
}

.ul-lock-desc {
  font-size: 24rpx;
  color: #a8a29e;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* ===== 购买按钮 ===== */
.ul-buy-btn {
  margin-top: 28rpx;
  background: linear-gradient(135deg, #7c3aed, #ec4899);
  color: #fff;
  border: none;
  padding: 24rpx 80rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.3);
  line-height: 1.5;
}

.ul-buy-btn::after {
  border: none;
}

.ul-buy-note {
  font-size: 22rpx;
  color: #c4b5fd;
  margin-top: 20rpx;
}

/* ===== 链接区 ===== */
.ul-links {
  margin-top: 28rpx;
  display: flex;
  gap: 32rpx;
  justify-content: center;
  align-items: center;
}

.ul-link {
  font-size: 24rpx;
  color: #8b5cf6;
  text-decoration: underline;
}

.ul-link-activation {
  color: #f59e0b;
  font-weight: 600;
}

.ul-link-divider {
  color: #e5e7eb;
  font-size: 24rpx;
}

/* ===== 激活码输入区 ===== */
.ul-activation-area {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff1f2;
  border: 1px solid #fde2e4;
}

.ul-activation-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1c1917;
  margin-bottom: 16rpx;
  text-align: center;
}

.ul-activation-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.ul-activation-input {
  flex: 1;
  letter-spacing: 12rpx;
  font-size: 32rpx;
  padding: 16rpx 24rpx;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  background: #fff;
  text-align: center;
}

.ul-activation-btn {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-weight: 700;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
  margin: 0;
}

.ul-activation-btn::after {
  border: none;
}

.ul-activation-msg {
  font-size: 22rpx;
  color: #f43f5e;
  text-align: center;
  margin-top: 12rpx;
}

/* ===== Footer ===== */
.ul-footer {
  background: #fff;
  padding: 0 48rpx 40rpx;
  text-align: center;
  border-radius: 0 0 40rpx 40rpx;
}

.ul-footer-tag {
  display: inline-block;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.06), rgba(236, 72, 153, 0.06));
  font-size: 22rpx;
  color: #a8a29e;
  letter-spacing: 2rpx;
}

.ul-close-btn {
  margin-top: 24rpx;
  border: 1px solid #e5e7eb;
  color: #78716c;
  font-size: 26rpx;
  padding: 16rpx 48rpx;
  border-radius: 16rpx;
  background: #fff;
  line-height: 1.5;
}

.ul-close-btn::after {
  border: none;
}

/* ===== 子弹窗（用户协议 / 隐私说明） ===== */
.ul-overlay-sub {
  background: rgba(0, 0, 0, 0.5);
}

.ul-sub-modal {
  width: 620rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.ul-sub-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
  text-align: center;
}

.ul-sub-scroll {
  height: 50vh;
}

.ul-sub-content {
  font-size: 26rpx;
  color: #78716c;
  line-height: 1.8;
}

.ul-sub-section {
  margin-top: 16rpx;
}

.ul-sub-section:first-child {
  margin-top: 0;
}

.ul-sub-bold {
  font-weight: 700;
  color: #1c1917;
}

.ul-sub-item {
  margin-left: 24rpx;
  margin-top: 8rpx;
}

.ul-sub-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  align-items: center;
}

.ul-sub-btn-outline {
  flex: 1;
  border: 1px solid #e5e7eb;
  color: #78716c;
  font-size: 26rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #fff;
  line-height: 1.5;
}

.ul-sub-btn-outline::after {
  border: none;
}

.ul-sub-btn-primary {
  flex: 2;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  border: none;
  font-size: 26rpx;
  font-weight: 700;
  padding: 20rpx 0;
  border-radius: 16rpx;
  line-height: 1.5;
}

.ul-sub-btn-primary::after {
  border: none;
}
