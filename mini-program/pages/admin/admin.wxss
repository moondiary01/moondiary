/* pages/admin/admin.wxss */
.admin-page {
  padding: 20rpx 0 40rpx;
  background: var(--bg);
  min-height: 100vh;
}

/* 用户统计网格 */
.admin-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.admin-stat-item {
  background: var(--rose-50);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
}
.admin-stat-total {
  grid-column: span 2;
  background: var(--grad-soft);
}
.admin-stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--rose-600);
  display: block;
  margin-bottom: 8rpx;
}
.admin-stat-lbl {
  font-size: 22rpx;
  color: var(--text-l);
}

/* 版本通知 */
.version-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.version-label {
  font-size: 28rpx;
  color: var(--text-l);
}

/* 付费管理 */
.payment-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.payment-btn-storage {
  flex: 1;
  background: var(--mint) !important;
  white-space: pre-line;
}
.payment-btn-beauty {
  flex: 1;
  background: linear-gradient(135deg, #8b5cf6, #ec4899) !important;
  white-space: pre-line;
}
.payment-status {
  margin-top: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--mint);
}

/* 密钥列表 */
.key-list {
  margin-top: 16rpx;
}
.key-row {
  background: var(--card);
  border: 2rpx solid var(--border);
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.key-row-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.key-code {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
  font-family: monospace;
}
.key-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.key-badge-free {
  background: #e5e7eb;
  color: #6b7280;
}
.key-badge-trial {
  background: var(--amber-l);
  color: var(--amber);
}
.key-badge-vip {
  background: var(--mint-l);
  color: var(--mint);
}
.key-badge-login {
  font-size: 22rpx;
}
.key-row-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx;
  background: var(--rose-50);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
.key-info-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-l);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.key-info-arrow {
  font-size: 24rpx;
  color: var(--rose-600);
  flex-shrink: 0;
}
.key-row-action {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.key-toggle {
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: none;
  background: var(--rose-50);
  color: var(--rose-600);
}
.key-toggle-on {
  background: var(--mint-l);
  color: var(--mint);
}
.key-toggle-off {
  background: var(--rose-50);
  color: var(--rose-600);
}
.key-toggle-revoked {
  background: #fee2e2;
  color: #ef4444;
}
.key-toggle-trial {
  background: var(--rose-50);
  color: var(--rose-600);
}
.key-toggle-trial-on {
  background: var(--amber-l);
  color: var(--amber);
}
.key-empty {
  text-align: center;
  padding: 40rpx;
  color: var(--text-l);
  font-size: 28rpx;
}

/* 动态密钥 */
.dynamic-key-result {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text);
}
.dynamic-key-code {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--rose-600);
  font-family: monospace;
  letter-spacing: 4rpx;
}

/* 用户信息弹窗 */
.user-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.user-info-main {
  flex: 1;
  min-width: 0;
}
.user-info-phone {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.user-info-meta {
  font-size: 24rpx;
  color: var(--text-l);
  margin-top: 4rpx;
}
.user-info-empty {
  text-align: center;
  padding: 40rpx;
  color: var(--text-l);
  font-size: 28rpx;
}
