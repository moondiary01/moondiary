/* pages/admin/admin.wxss */
.admin-page {
  padding-bottom: 40rpx;
}
.sub {
  font-size: 22rpx;
  color: var(--text-l);
  font-weight: 400;
  margin-left: 8rpx;
}

/* 统计 */
.stat-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.stat-row-second {
  margin-top: 0;
}
.stat-cell {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: var(--rose-50);
  border-radius: 24rpx;
  border: 2rpx solid var(--border);
}
.stat-total {
  background: var(--rose-100);
  border-color: var(--rose-300);
}
.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--rose-600);
  display: block;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-l);
  margin-top: 8rpx;
  display: block;
}

/* 通知 */
.notice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.notice-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.notice-version {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}
.notice-status {
  font-size: 24rpx;
  color: var(--text-l);
}
.notice-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

/* 付费管理 */
.pay-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.pay-basic-btn {
  background: linear-gradient(135deg, #7C3AED, #A855F7);
}
.pay-upgrade-btn {
  background: linear-gradient(135deg, #A855F7, #EC4899);
}
.pay-status {
  font-size: 24rpx;
  color: var(--mint);
  display: block;
  margin-top: 12rpx;
  text-align: center;
}

/* 筛选 */
.filter-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.filter-btn {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--text-l);
  background: var(--rose-50);
  border: 2rpx solid var(--border);
  transition: all 0.15s;
}
.filter-active {
  background: var(--rose-500);
  color: #fff;
  border-color: var(--rose-500);
}

/* 密钥列表 */
.key-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.key-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx;
  background: var(--rose-50);
  border-radius: 24rpx;
  border: 2rpx solid var(--border);
  gap: 12rpx;
}
.key-main {
  flex: 1;
  min-width: 0;
}
.key-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}
.key-num {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--ink);
}
.key-version-tag {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
}
.ver-upgrade {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  color: #78350f;
}
.ver-normal {
  background: var(--rose-100);
  color: var(--rose-600);
}
.key-login-status {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--mint-l);
  color: var(--mint);
}
.key-login-off {
  background: #f5f5f4;
  color: var(--text-l);
}
.key-detail {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.key-phone {
  font-size: 24rpx;
  color: var(--text-l);
}
.key-user-info {
  font-size: 22rpx;
  color: var(--rose-400);
}
.key-remark {
  font-size: 22rpx;
  color: var(--gold-d);
}
.key-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}
.key-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.key-status.active {
  background: var(--mint-l);
  color: var(--mint);
}
.key-status.inactive {
  background: var(--amber-l);
  color: var(--amber);
}
.key-status.revoked {
  background: #fee2e2;
  color: #dc2626;
}
.key-actions {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.mini-btn {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  border: none;
  font-weight: 600;
}
.mini-btn-outline {
  background: #fff;
  color: var(--rose-600);
  border: 2rpx solid var(--rose-300);
}

/* 用户弹窗 */
.users-list {
  max-height: 50vh;
  overflow-y: auto;
  margin-bottom: 20rpx;
}
.user-phone-item {
  padding: 16rpx;
  border-bottom: 1rpx solid var(--border);
}
.user-phone-text {
  font-size: 28rpx;
  color: var(--ink);
}
.users-empty {
  text-align: center;
  padding: 40rpx;
  color: var(--text-l);
  font-size: 26rpx;
}
