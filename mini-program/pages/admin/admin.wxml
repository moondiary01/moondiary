<!-- pages/admin/admin.wxml -->
<view class="admin-page">
  <!-- 用户统计（按分类：试用期/普通版/升级版/密钥用户） -->
  <view class="card">
    <view class="card-title">管理后台 <text class="sub">Moon 专属</text></view>
    <view class="admin-stat-grid">
      <view class="admin-stat-item admin-stat-clickable" bindtap="showUsersByType" data-type="trial">
        <text class="admin-stat-num">{{adminStats.trial}}</text>
        <text class="admin-stat-lbl">试用期用户 · 点击查看</text>
      </view>
      <view class="admin-stat-item admin-stat-clickable" bindtap="showUsersByType" data-type="basic">
        <text class="admin-stat-num">{{adminStats.basic}}</text>
        <text class="admin-stat-lbl">普通版用户 · 点击查看</text>
      </view>
      <view class="admin-stat-item admin-stat-clickable" bindtap="showUsersByType" data-type="upgrade">
        <text class="admin-stat-num">{{adminStats.upgrade}}</text>
        <text class="admin-stat-lbl">升级版用户 · 点击查看</text>
      </view>
      <view class="admin-stat-item admin-stat-clickable" bindtap="showUsersByType" data-type="keyUser">
        <text class="admin-stat-num">{{adminStats.keyUser}}</text>
        <text class="admin-stat-lbl">密钥用户 · 点击查看</text>
      </view>
      <view class="admin-stat-item admin-stat-total" bindtap="showAllUsers">
        <text class="admin-stat-num">{{adminStats.total}}</text>
        <text class="admin-stat-lbl">总人数 · 点击查看</text>
      </view>
    </view>
  </view>

  <!-- 预览试用弹窗 -->
  <view class="card">
    <view class="card-title">预览与调试</view>
    <button class="btn btn-outline" bindtap="previewTrialPopup">预览 19.9 试用弹窗</button>
  </view>

  <!-- 版本更新通知 -->
  <view class="card">
    <view class="card-title">版本更新通知</view>
    <view class="version-info">
      <text class="version-label">当前版本：v{{appVersion}}</text>
      <button class="btn btn-outline btn-sm" bindtap="sendVersionNotice">发送通知</button>
    </view>
    <input class="input" style="margin-top:16rpx" placeholder="通知内容" value="{{noticeContent}}" bindinput="onNoticeInput" />
  </view>

  <!-- 付费管理 -->
  <view class="card">
    <view class="card-title">付费管理 <text class="sub">手动开通用户</text></view>
    <view class="input-group">
      <input class="input" type="number" maxlength="11" placeholder="输入用户手机号（11位）" value="{{paymentPhone}}" bindinput="onPaymentPhoneInput" />
    </view>
    <view class="payment-btns">
      <button class="btn btn-primary payment-btn-storage" bindtap="adminGrantPayment" data-type="storage">开通 19.9元\n<text style="font-size:24rpx;opacity:0.85">云端存储</text></button>
      <button class="btn btn-primary payment-btn-beauty" bindtap="adminGrantPayment" data-type="beauty">开通 29.9元\n<text style="font-size:24rpx;opacity:0.85">变美计划+云存储</text></button>
    </view>
    <view class="payment-status" wx:if="{{paymentStatus}}">{{paymentStatus}}</view>
  </view>

  <!-- 密钥管理 -->
  <view class="card">
    <view class="card-title">密钥管理</view>
    <view class="input-group">
      <input class="input" type="number" maxlength="11" placeholder="搜索用户手机号/微信号" value="{{keySearchPhone}}" bindinput="onKeySearchInput" />
    </view>
    <view class="key-list">
      <block wx:for="{{keyList}}" wx:key="code">
        <view class="key-row">
          <view class="key-row-main">
            <text class="key-code">{{item.code}}</text>
            <text class="key-badge key-badge-{{item.userType}}">{{item.userTypeLabel}}</text>
            <text class="key-badge key-badge-version" wx:if="{{item.versionBadge}}" style="{{item.versionBadgeStyle}}">{{item.versionLabel}}</text>
            <text class="key-badge key-badge-login" style="{{item.loginBadgeStyle}}">{{item.loginLabel}}</text>
          </view>
          <view class="key-row-info" bindtap="editKeyNote" data-key="{{item.code}}">
            <text class="key-info-text">{{item.infoText || '点击编辑'}}</text>
            <text class="key-info-arrow">编辑 ›</text>
          </view>
          <view class="key-row-action">
            <button class="key-toggle {{item.toggleClass}}" bindtap="toggleKey" data-key="{{item.code}}">{{item.toggleLabel}}</button>
            <button class="key-toggle key-toggle-trial {{item.trialActive ? 'key-toggle-trial-on' : ''}}" wx:if="{{item.showTrialBtn}}" bindtap="toggleBeautyTrial" data-phone="{{item.phone}}">{{item.trialLabel}}</button>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{keyList.length === 0}}" class="key-empty">暂无密钥</view>
  </view>

  <!-- 动态密钥生成 -->
  <view class="card">
    <view class="card-title">动态密钥生成</view>
    <button class="btn btn-primary" bindtap="generateDynamicKey"> 生成新密钥</button>
    <view wx:if="{{newDynamicKey}}" class="dynamic-key-result">
      <text>新密钥：</text>
      <text class="dynamic-key-code">{{newDynamicKey}}</text>
    </view>
  </view>

  <!-- 管理员密码修改 -->
  <view class="card">
    <view class="card-title">管理员密码 <text class="sub">登录后可修改</text></view>
    <view class="input-group">
      <text class="input-label">当前密码</text>
      <input class="input" type="text" password="{{true}}" placeholder="输入当前管理员密码" value="{{oldPw}}" bindinput="onOldPwInput" />
    </view>
    <view class="input-group">
      <text class="input-label">新密码</text>
      <input class="input" type="text" password="{{true}}" placeholder="设置新密码（至少6位）" value="{{newPw}}" bindinput="onNewPwInput" />
    </view>
    <view class="input-group">
      <text class="input-label">确认新密码</text>
      <input class="input" type="text" password="{{true}}" placeholder="再次输入新密码" value="{{newPw2}}" bindinput="onNewPw2Input" />
    </view>
    <button class="btn btn-primary" bindtap="changeAdminPw">保存新密码</button>
  </view>
</view>

<!-- 用户详情弹窗 -->
<view class="overlay" wx:if="{{showUsersModal}}" bindtap="closeUsersModal">
  <view class="modal" catchtap>
    <view class="modal-title">{{usersModalTitle}}</view>
    <scroll-view scroll-y style="max-height:60vh">
      <block wx:for="{{usersModalList}}" wx:key="phone">
        <view class="user-info-row">
          <view class="user-info-main">
            <text class="user-info-phone">{{item.phone}}</text>
            <text class="user-info-meta">{{item.meta}}</text>
          </view>
          <text class="key-badge {{item.userTypeClass}}">{{item.userType}}</text>
          <text class="login-badge {{item.loginBadgeClass}}">{{item.loginBadge}}</text>
        </view>
      </block>
      <view wx:if="{{usersModalList.length === 0}}" class="user-info-empty">暂无此类用户</view>
    </scroll-view>
    <view class="modal-actions">
      <button class="btn btn-primary" bindtap="closeUsersModal">关闭</button>
    </view>
  </view>
</view>

<!-- 密钥备注编辑弹窗 -->
<view class="overlay" wx:if="{{showKeyEditModal}}" bindtap="closeKeyEditModal">
  <view class="modal" catchtap>
    <view class="modal-title">{{editingKeyTitle}}</view>
    <view class="input-group">
      <text class="input-label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="用户手机号" value="{{editingKeyPhone}}" bindinput="onEditKeyPhoneInput" />
    </view>
    <view class="input-group">
      <text class="input-label">性别</text>
      <input class="input" placeholder="男/女" value="{{editingKeyGender}}" bindinput="onEditKeyGenderInput" />
    </view>
    <view class="input-group">
      <text class="input-label">年龄</text>
      <input class="input" type="number" placeholder="年龄" value="{{editingKeyAge}}" bindinput="onEditKeyAgeInput" />
    </view>
    <view class="input-group">
      <text class="input-label">昵称</text>
      <input class="input" placeholder="用户昵称" value="{{editingKeyNickname}}" bindinput="onEditKeyNicknameInput" />
    </view>
    <view class="input-group">
      <text class="input-label">备注</text>
      <input class="input" placeholder="备注信息" value="{{editingKeyNote}}" bindinput="onEditKeyNoteInput" />
    </view>
    <view class="modal-actions">
      <button class="btn btn-outline" bindtap="closeKeyEditModal">取消</button>
      <button class="btn btn-primary" bindtap="saveKeyNote">保存</button>
    </view>
  </view>
</view>
