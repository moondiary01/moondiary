<!-- pages/index/index.wxml -->
<pay-modal show="{{showPayModal}}" bind:close="onPayModalClose" />

<view class="index-page">

  <!-- ===== Hero ===== -->
  <view class="hero">
    <view class="hero-inner">
      <view class="hero-top">
        <view class="hero-left">
          <view class="hero-title">
            <text class="brand">Moon Memo</text>
            <text class="hero-sub">月亮日记</text>
          </view>
          <view class="hero-clock">{{todayStr}}</view>
          <view class="hero-actions">
            <view class="unit-toggle">
              <text class="unit-btn {{unitLabel === 'kg' ? 'unit-active' : ''}}" bindtap="onSwitchUnit" data-unit="kg">kg</text>
              <text class="unit-btn {{unitLabel === '斤' ? 'unit-active' : ''}}" bindtap="onSwitchUnit" data-unit="斤">斤</text>
            </view>
            <text class="btn-glass" bindtap="onOpenSettings">设置</text>
            <text class="btn-glass" bindtap="onLogout">退出</text>
          </view>
        </view>
        <view class="hero-avatar-box">
          <view class="avatar avatar-lg" bindtap="onOpenSettings">{{userAvatar || '🌙'}}</view>
          <view class="hero-nickname" bindtap="onOpenSettings">{{userName || '点击设置'}}</view>
        </view>
      </view>
      <view class="profile-bar">
        <view class="profile-info">
          <view class="pf-item" bindtap="onScrollToTop">
            <text class="pf-value pf-weight-val">{{todayWeightDisplay}}</text>
            <text class="pf-label">今日体重</text>
          </view>
          <view class="pf-item" bindtap="onOpenSettings">
            <text class="pf-label">性别</text>
            <text class="pf-value">{{userGender || '—'}}</text>
          </view>
          <view class="pf-item" bindtap="onOpenSettings">
            <text class="pf-label">年龄</text>
            <text class="pf-value">{{userAge || '—'}}</text>
          </view>
          <view class="pf-item" bindtap="onOpenSettings">
            <text class="pf-label">身高</text>
            <text class="pf-value">{{userHeight || '—'}}</text>
          </view>
        </view>
      </view>
      <!-- 升级版快捷入口（仅已购用户可见） -->
      <view class="beauty-quick-btns" wx:if="{{showBeautyQuick}}">
        <view class="beauty-quick-btn beauty-quick-skincare" bindtap="onOpenSkincare">
          <text class="beauty-quick-title">护肤日记</text>
          <text class="beauty-quick-sub">SKINCARE DIARY</text>
        </view>
        <view class="beauty-quick-btn beauty-quick-mood" bindtap="onOpenMood">
          <text class="beauty-quick-title">心情日记</text>
          <text class="beauty-quick-sub">MOOD DIARY</text>
        </view>
      </view>
      <!-- 19.9元普通版购买入口（试用/未购用户可见） -->
      <view class="basic-plan-entry" wx:if="{{showBasicPlanEntry}}" bindtap="onOpenBasicPay">
        <view class="basic-plan-glow basic-plan-glow-gold"></view>
        <view class="basic-plan-inner">
          <view class="basic-plan-left">
            <text class="basic-plan-title">解锁全部功能</text>
            <text class="basic-plan-sub">一次购买 · 永久会员权益 · 云端储存</text>
          </view>
          <view class="basic-plan-price-pill">
            <text class="basic-plan-yuan">¥</text>
            <text class="basic-plan-num">19.9</text>
            <text class="basic-plan-perm">永久</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- === TOP TABS === -->
  <view class="top-tabs">
    <view class="top-tab {{currentTab===0?'active':''}}" bindtap="onSwitchTab" data-idx="0">每日记录</view>
    <view class="top-tab {{currentTab===1?'active':''}}" bindtap="onSwitchTab" data-idx="1">趋势统计</view>
    <view class="top-tab {{currentTab===2?'active':''}}" bindtap="onSwitchTab" data-idx="2">计划详情</view>
    <view class="top-tab {{currentTab===3?'active':''}}" bindtap="onSwitchTab" data-idx="3">周度复盘</view>
    <view class="top-tab {{currentTab===4?'active':''}}" bindtap="onSwitchTab" data-idx="4">经期日历</view>
  </view>

  <!-- Tab 0: 每日记录 -->
  <view class="main-content" wx:if="{{currentTab===0}}">
    <!-- ===== 仪表盘 6项 ===== -->
    <view class="dash">
      <view class="dash-item" bindtap="onEditField" data-field="startDate">
        <text class="dash-label">计划天数</text>
        <text class="dash-value">{{dashTotalDays || '—'}}</text>
      </view>
      <view class="dash-item">
        <text class="dash-label">当前第几天</text>
        <text class="dash-value light-pink">{{dashCurrentDay || '—'}}</text>
      </view>
      <view class="dash-item" bindtap="onEditField" data-field="startWeight">
        <text class="dash-label">起始体重</text>
        <text class="dash-value">{{dashStartWeight || '—'}}</text>
      </view>
      <view class="dash-item" bindtap="onEditField" data-field="targetWeight">
        <text class="dash-label">目标体重</text>
        <text class="dash-value coral">{{dashTargetWeight || '—'}}</text>
      </view>
      <view class="dash-item">
        <text class="dash-label">已减重</text>
        <text class="dash-value mint">{{dashLostWeight || '—'}}</text>
      </view>
      <view class="dash-item">
        <text class="dash-label">最新体重</text>
        <text class="dash-value amber">{{dashLatestWeight || '—'}}</text>
      </view>
    </view>

    <!-- ===== 减重进度条 ===== -->
    <view class="card progress-card">
      <view class="card-title">减重进度</view>
      <view class="progress-wrap">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progressPercent}}%"></view>
        </view>
        <view class="progress-text">{{progressPercent}}%</view>
      </view>
    </view>

    <!-- ===== 今日记录 ===== -->
    <view class="card today-card">
      <view class="card-title">今日记录 <text class="sub">输入自动保存</text></view>

      <!-- 体重 Hero：深紫渐变 + 早晚体重 + 体脂率 -->
      <view class="weight-hero">
        <view class="today-block-header">
          <view class="today-block-dot w"></view>
          <text class="today-block-title">早晚体重打卡</text>
          <text class="today-block-sub">{{unitLabel}}</text>
        </view>
        <view class="am-pm-row">
          <input class="weight-input-am" type="digit" placeholder="点击输入 晨起体重（空腹排便后）" value="{{dayData.weightAM ? (unitLabel === '斤' ? (dayData.weightAM * 2).toFixed(1) : Number(dayData.weightAM).toFixed(1)) : ''}}" bindinput="onMorningWeightInput" bindblur="onMorningWeightBlur" />
          <input class="weight-input-pm" type="digit" placeholder="点击输入 睡前体重" value="{{dayData.weightPM ? (unitLabel === '斤' ? (dayData.weightPM * 2).toFixed(1) : Number(dayData.weightPM).toFixed(1)) : ''}}" bindinput="onEveningWeightInput" bindblur="onEveningWeightBlur" />
        </view>
        <view class="fat-inline">
          <text class="fat-inline-label">体脂率</text>
          <input class="fat-inline-input" type="digit" placeholder="--" value="{{dayData.fat || ''}}" bindinput="onFatRateInput" bindblur="onFatRateBlur" />
          <text class="fat-inline-unit">%</text>
        </view>
      </view>

      <!-- 喝水打卡 -->
      <view class="today-block water-block">
        <view class="today-block-header">
          <view class="today-block-dot h"></view>
          <text class="today-block-title">喝水打卡</text>
        </view>
        <view class="water-cups">
          <view wx:for="{{waterCups}}" wx:key="index"
            class="water-cup {{item.filled ? 'water-cup-filled' : ''}}"
            bindtap="onWaterAdd"
            data-index="{{index}}">
            {{index + 1}}
          </view>
        </view>
        <view class="water-info">已喝 <text class="water-bold">{{dayData.water || 0}}</text> 杯 <text class="water-bold">{{waterMl}}</text>ml</view>
        <view class="water-goal-progress">目标 {{waterGoal}} ml</view>
      </view>

      <!-- 健康三合一：排便 + 运动 + 饮食 -->
      <view class="health-trio">
        <view class="health-trio-row">
          <!-- 排便 -->
          <view class="health-trio-cell">
            <text class="health-trio-label">排便</text>
            <picker mode="selector" range="{{bmOptions}}" value="{{bmIndex}}" bindchange="onBmChange">
              <view class="health-trio-picker {{dayData.bm ? 'health-trio-picker-active' : ''}}">
                {{dayData.bm || '—'}}
              </view>
            </picker>
          </view>
          <!-- 运动 -->
          <view class="health-trio-cell">
            <text class="health-trio-label">运动</text>
            <picker mode="selector" range="{{exerciseTrioOptions}}" value="{{exerciseIndex}}" bindchange="onExerciseChange">
              <view class="health-trio-picker {{dayData.exercise ? 'health-trio-picker-active' : ''}}">
                {{dayData.exercise || '—'}}
              </view>
            </picker>
          </view>
        </view>
        <!-- 饮食（占满一行） -->
        <view class="health-trio-diet-row">
          <text class="health-trio-label">饮食</text>
          <scroll-view scroll-x="true" class="diet-scroll">
            <view class="diet-tag-list">
              <view wx:for="{{dietOptions}}" wx:key="*this"
                class="diet-tag {{dayData.diet === item ? 'diet-tag-active' : ''}}"
                bindtap="onDietSelect" data-value="{{item}}">
                {{item}}
              </view>
            </view>
          </scroll-view>
        </view>
      </view>

      <!-- 生理期（仅女性） -->
      <view class="today-block period-block" wx:if="{{isFemale}}">
        <view class="today-block-header">
          <view class="today-block-dot p"></view>
          <text class="today-block-title">生理期记录</text>
        </view>
        <view class="period-row">
          <view class="period-chip {{dayData.period ? 'period-chip-active' : ''}}" bindtap="onPeriodToggle">今天来月经</view>
          <view class="period-chip {{dayData.periodEnd ? 'period-chip-active' : ''}}" wx:if="{{dayData.period}}" bindtap="onPeriodEndToggle">标记结束</view>
        </view>
        <view class="period-status" wx:if="{{periodStatusText}}">{{periodStatusText}}</view>
        <textarea class="period-note" placeholder="症状/流量备注（如：量多、痛经）" value="{{dayData.periodNote}}" bindinput="onPeriodNoteInput" bindblur="onPeriodNoteBlur" maxlength="200"></textarea>
      </view>

      <!-- 备注/日记 -->
      <view class="today-block note-block">
        <view class="today-block-header">
          <view class="today-block-dot n"></view>
          <text class="today-block-title">备注/日记</text>
        </view>
        <textarea class="note-textarea" placeholder="记录今天的心情与感悟..." value="{{dayData.note}}" bindinput="onNoteInput" bindblur="onNoteBlur" maxlength="500" auto-height></textarea>
      </view>
    </view>

    <!-- ===== 完整记录表（按月分组折叠） ===== -->
    <view class="card">
      <view class="card-title">完整记录表</view>
      <view class="record-accordion">
        <view class="month-section" wx:for="{{monthGroups}}" wx:key="month">
          <view class="month-header" bindtap="onToggleMonth" data-month="{{item.month}}">
            <text class="month-title">{{item.month}}</text>
            <text class="month-count">{{item.records.length}}条</text>
            <text class="month-arrow {{item.expanded ? 'month-arrow-open' : ''}}">›</text>
          </view>
          <view class="month-body" wx:if="{{item.expanded}}">
            <view class="record-row" wx:for="{{item.records}}" wx:for-item="rec" wx:key="date">
              <text class="record-date">{{rec.dateStr}}</text>
              <text class="record-weight">{{rec.weight || '—'}}</text>
              <text class="record-bm">{{rec.bm || '—'}}</text>
              <text class="record-exercise">{{rec.exercise || '—'}}</text>
              <text class="record-diet">{{rec.diet || '—'}}</text>
            </view>
          </view>
        </view>
        <view class="record-empty" wx:if="{{monthGroups.length === 0}}">暂无记录</view>
      </view>
    </view>

    <!-- ===== 升级版入口卡片（仅已购普通版或升级版用户可见） ===== -->
    <view class="beauty-entry-card" bindtap="onGoBeauty" wx:if="{{!hideBeautyEntry && canSeeUpgrade}}">
      <view class="beauty-glow beauty-glow-pink"></view>
      <view class="beauty-glow beauty-glow-gold"></view>
      <view class="beauty-entry-inner">
        <view class="beauty-entry-top">
          <view class="beauty-entry-title-wrap">
            <text class="beauty-entry-title">100天变美日记</text>
            <view class="beauty-entry-sub-row">
              <text class="beauty-entry-en">UPGRADE · YOUR BEST SELF</text>
              <text class="beauty-entry-badge">升级版</text>
            </view>
          </view>
          <text class="beauty-entry-arrow">›</text>
        </view>
        <view class="beauty-features-row">
          <text class="beauty-feat-chip">护肤日记</text>
          <text class="beauty-feat-chip">心情记录</text>
          <text class="beauty-feat-chip">感恩日记</text>
          <text class="beauty-feat-chip">自律打卡</text>
        </view>
        <view class="beauty-entry-bottom">
          <text class="beauty-entry-subline">一次购买 · 永久会员权益 · 云端储存</text>
        </view>
      </view>
    </view>

    <!-- ===== 管理员入口 ===== -->
    <view class="admin-entry-card" wx:if="{{isAdmin}}">
      <view class="admin-entry" bindtap="onGoAdmin">
        <text class="admin-entry-text">⚙️ 管理后台</text>
        <text class="admin-entry-arrow">›</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view style="height: 120rpx;"></view>
  </view>

  <!-- Tab 1: 趋势统计 -->
  <view class="main-content" wx:if="{{currentTab===1}}">
    <!-- 体重趋势图 -->
    <view class="card">
      <view class="card-title">体重趋势图</view>
      <view class="chart-legend">
        <view class="legend-item">
          <view class="legend-dot legend-morning"></view>
          <text>晨起体重</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-evening"></view>
          <text>晚间体重</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-fat"></view>
          <text>体脂率</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-period"></view>
          <text>经期</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot legend-period-zone"></view>
          <text>经期区间</text>
        </view>
      </view>
      <canvas canvas-id="weightChart" id="weightChart" class="chart-canvas"></canvas>
      <view class="chart-empty" wx:if="{{!chartHasData}}">
        <text>暂无体重数据，去记录吧~</text>
      </view>
    </view>

    <!-- 周条形图 -->
    <view class="card">
      <view class="card-title">每周体重变化 (kg)</view>
      <canvas canvas-id="chartWeekBar" id="chartWeekBar" class="chart-bar-canvas"></canvas>
    </view>

    <!-- BMI 卡片：环形图 + 分类 -->
    <view class="card">
      <view class="card-title">BMI 指数</view>
      <view class="bmi-row-new">
        <view class="bmi-ring-wrap">
          <view class="bmi-ring {{bmiClass}}">
            <text class="bmi-ring-num">{{bmiValue || '--'}}</text>
            <text class="bmi-ring-lbl">BMI</text>
          </view>
        </view>
        <view class="bmi-info-right">
          <view class="bmi-cat">{{bmiStatus || '数据不足'}}</view>
          <view class="bmi-desc" wx:if="{{bmiValue}}">
            <text wx:if="{{bmiClass === 'bmi-thin'}}">体重过轻，建议加强营养和力量训练</text>
            <text wx:elif="{{bmiClass === 'bmi-normal'}}">体重标准，继续保持健康生活方式</text>
            <text wx:elif="{{bmiClass === 'bmi-over'}}">体重偏重，建议控制饮食+增加运动</text>
            <text wx:elif="{{bmiClass === 'bmi-obese'}}">体重肥胖，建议咨询医生制定减重计划</text>
          </view>
          <view class="bmi-tags">
            <text class="bmi-tag bmi-tag-thin">偏瘦 &lt;18.5</text>
            <text class="bmi-tag bmi-tag-normal">标准 18.5-23.9</text>
            <text class="bmi-tag bmi-tag-over">偏胖 24-27.9</text>
            <text class="bmi-tag bmi-tag-obese">肥胖 ≥28</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 数据统计 10 项 -->
    <view class="card">
      <view class="card-title">数据统计</view>
      <view class="stat-grid-new">
        <view class="stat-item">
          <text class="stat-val">{{statStartWeight || '—'}}</text>
          <text class="stat-lbl">起始体重</text>
        </view>
        <view class="stat-item">
          <text class="stat-val coral">{{statTargetWeight || '—'}}</text>
          <text class="stat-lbl">目标体重</text>
        </view>
        <view class="stat-item">
          <text class="stat-val amber">{{statLatestWeight || '—'}}</text>
          <text class="stat-lbl">最新体重</text>
        </view>
        <view class="stat-item">
          <text class="stat-val mint">{{statLostWeight || '—'}}</text>
          <text class="stat-lbl">已减重</text>
        </view>
        <view class="stat-item">
          <text class="stat-val">{{statStartFat || '—'}}</text>
          <text class="stat-lbl">起始体脂率</text>
        </view>
        <view class="stat-item">
          <text class="stat-val">{{statLatestFat || '—'}}</text>
          <text class="stat-lbl">最新体脂率</text>
        </view>
        <view class="stat-item">
          <text class="stat-val mint">{{statFatDiff || '—'}}</text>
          <text class="stat-lbl">体脂变化</text>
        </view>
        <view class="stat-item">
          <text class="stat-val pink">{{statRecordDays || 0}}</text>
          <text class="stat-lbl">记录天数</text>
        </view>
        <view class="stat-item">
          <text class="stat-val rose">{{bmiValue || '—'}}</text>
          <text class="stat-lbl">当前BMI</text>
        </view>
        <view class="stat-item dash-clickable" bindtap="onEditMeasure" data-field="all">
          <text class="stat-val gold">{{hasMeasure ? '✓' : '—'}}</text>
          <text class="stat-lbl">三围记录</text>
        </view>
      </view>
    </view>

    <!-- 编辑三围弹窗 -->
    <view class="overlay" wx:if="{{showEditModal}}" bindtap="onCloseModal">
      <view class="modal" catchtap="">
        <view class="modal-title">编辑三围 (cm)</view>
        <view class="input-group">
          <text class="input-label">胸围</text>
          <input class="input" type="digit" placeholder="请输入胸围" value="{{editBust}}" bindinput="onEditInput" data-field="editBust" />
        </view>
        <view class="input-group">
          <text class="input-label">腰围</text>
          <input class="input" type="digit" placeholder="请输入腰围" value="{{editWaist}}" bindinput="onEditInput" data-field="editWaist" />
        </view>
        <view class="input-group">
          <text class="input-label">臀围</text>
          <input class="input" type="digit" placeholder="请输入臀围" value="{{editHip}}" bindinput="onEditInput" data-field="editHip" />
        </view>
        <view class="modal-actions">
          <button class="btn btn-outline" bindtap="onCloseModal">取消</button>
          <button class="btn btn-primary" bindtap="onConfirmEdit">保存</button>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 2: 计划详情 -->
  <view class="main-content" wx:if="{{currentTab===2}}">
    <!-- 基本信息卡片 -->
    <view class="card" bindtap="onPlanEditCard" data-card="basic">
      <view class="card-title">基本信息</view>
      <view class="info-grid">
        <view class="info-cell">
          <text class="info-label">姓名</text>
          <text class="info-value">{{planState.name || '未设置'}}</text>
        </view>
        <view class="info-cell">
          <text class="info-label">性别</text>
          <text class="info-value">{{planState.gender || '未设置'}}</text>
        </view>
        <view class="info-cell">
          <text class="info-label">年龄</text>
          <text class="info-value">{{planState.age || '--'}}</text>
        </view>
        <view class="info-cell">
          <text class="info-label">身高</text>
          <text class="info-value">{{planState.height || '--'}} cm</text>
        </view>
      </view>
      <view class="edit-hint">点击编辑</view>
    </view>

    <!-- 三阶段计划 -->
    <view class="card">
      <view class="card-title">三阶段计划</view>
      <view class="stage-card stage-s1">
        <view class="stage-header">
          <text class="stage-num">阶段一</text>
          <text class="stage-name">适应期</text>
          <text class="stage-range">第 1-30 天</text>
        </view>
        <view class="stage-goal">目标：建立记录习惯，了解身体数据变化规律</view>
        <view class="stage-tips">
          <text>• 每天固定时间称重（晨起空腹 + 睡前）</text>
          <text>• 记录排便、运动、饮食情况</text>
          <text>• 不需要刻意节食，保持日常饮食习惯</text>
          <text>• 建立喝水习惯，每天至少 1500ml</text>
        </view>
      </view>
      <view class="stage-card stage-s2">
        <view class="stage-header">
          <text class="stage-num">阶段二</text>
          <text class="stage-name">加速期</text>
          <text class="stage-range">第 31-60 天</text>
        </view>
        <view class="stage-goal">目标：稳定减重节奏，每周减 0.5-1 kg</view>
        <view class="stage-tips">
          <text>• 控制每日热量摄入，参考饮食表</text>
          <text>• 每周至少 3 次有氧运动（30分钟以上）</text>
          <text>• 增加蛋白质摄入，减少精制碳水</text>
          <text>• 保证 7-8 小时睡眠，减少压力</text>
        </view>
      </view>
      <view class="stage-card stage-s3">
        <view class="stage-header">
          <text class="stage-num">阶段三</text>
          <text class="stage-name">巩固期</text>
          <text class="stage-range">第 61-100 天</text>
        </view>
