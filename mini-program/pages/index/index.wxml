<!-- pages/index/index.wxml -->
<pay-modal show="{{showPayModal}}" bind:close="onPayModalClose" />

<view class="index-page">

  <!-- 顶部信息（非固定，随页面滚动） -->
  <view class="hero-card">
    <view class="hero-top">
      <view class="hero-name">{{userName || '你好'}}</view>
      <view class="hero-date">{{todayStr}}</view>
    </view>
    <view class="hero-bottom-row">
      <view class="hero-weight-col">
        <view class="hero-weight">
          <text class="hero-weight-num">{{todayWeightDisplay}}</text>
          <text class="hero-weight-unit">{{unitLabel}}</text>
        </view>
        <view class="hero-weight-label">今日体重</view>
      </view>
      <!-- 已购用户快捷入口 — 靠右 -->
      <view class="hero-beauty-quick" wx:if="{{isBeautyUser}}">
        <view class="hero-quick-btn hero-quick-skincare" bindtap="onGoSkincare">
          <text class="hero-quick-icon">🧴</text>
          <text class="hero-quick-text">护肤日记</text>
        </view>
        <view class="hero-quick-btn hero-quick-mood" bindtap="onGoMood">
          <text class="hero-quick-icon">💗</text>
          <text class="hero-quick-text">心情日记</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 体重 + 体脂 Hero 卡片 -->
  <view class="weight-hero">
    <view class="weight-hero-header">
      <view class="weight-hero-dot"></view>
      <text class="weight-hero-title">早晚体重打卡</text>
      <text class="weight-hero-unit">{{unitLabel}}</text>
    </view>
    <view class="weight-hero-row">
      <input class="weight-input-am" type="digit" placeholder="点击输入 晨起体重（空腹排便后）" value="{{dayData.weightAM ? (unitLabel === '斤' ? (dayData.weightAM * 2).toFixed(1) : Number(dayData.weightAM).toFixed(1)) : ''}}" bindinput="onMorningWeightInput" bindblur="onMorningWeightBlur" />
      <input class="weight-input-pm" type="digit" placeholder="点击输入 睡前体重" value="{{dayData.weightPM ? (unitLabel === '斤' ? (dayData.weightPM * 2).toFixed(1) : Number(dayData.weightPM).toFixed(1)) : ''}}" bindinput="onEveningWeightInput" bindblur="onEveningWeightBlur" />
    </view>
    <view class="weight-hero-fat">
      <text class="fat-label">体脂率</text>
      <input class="fat-input" type="digit" placeholder="--" value="{{dayData.fat || ''}}" bindinput="onFatRateInput" bindblur="onFatRateBlur" />
      <text class="fat-unit">%</text>
    </view>
  </view>

  <!-- 喝水打卡 -->
  <view class="water-block">
    <view class="water-block-header">
      <view class="water-block-dot"></view>
      <text class="water-block-title">喝水打卡</text>
    </view>
    <view class="water-cups-row">
      <view wx:for="{{waterCups}}" wx:key="index"
        class="water-cup {{item.filled ? 'water-cup-filled' : ''}}"
        bindtap="onWaterAdd"
        data-index="{{index}}">
        {{index + 1}}
      </view>
    </view>
    <view class="water-info-row">
      <text>已喝 <text class="water-count-num">{{dayData.water || 0}}</text> 杯 <text class="water-count-num">{{waterMl}}</text>ml</text>
    </view>
    <view class="water-goal-text">目标 {{waterGoal}} ml</view>
  </view>

  <!-- 健康三合一：排便 + 运动 + 饮食 -->
  <view class="health-trio">
    <view class="health-trio-row">
      <!-- 排便 -->
      <view class="health-trio-cell">
        <view class="health-trio-label">排便</view>
        <picker mode="selector" range="{{bmOptions}}" value="{{bmIndex}}" bindchange="onBmChange">
          <view class="health-trio-picker {{dayData.bm ? 'health-trio-picker-active' : ''}}">
            {{dayData.bm || '—'}}
          </view>
        </picker>
      </view>
      <!-- 运动 -->
      <view class="health-trio-cell">
        <view class="health-trio-label">运动</view>
        <picker mode="selector" range="{{exerciseTrioOptions}}" value="{{exerciseIndex}}" bindchange="onExerciseChange">
          <view class="health-trio-picker {{dayData.exercise ? 'health-trio-picker-active' : ''}}">
            {{dayData.exercise || '—'}}
          </view>
        </picker>
      </view>
      <!-- 饮食（占满一行） -->
      <view class="health-trio-cell health-trio-diet">
        <view class="health-trio-label">饮食</view>
        <scroll-view scroll-x="true" class="diet-scroll">
          <view class="diet-tag-list">
            <view wx:for="{{dietOptions}}" wx:key="*this"
              class="diet-tag {{dayData.diet === item ? 'diet-tag-active' : ''}}"
              bindtap="onDietSelect" data-value="{{item}}">
              {{item}}
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 经期备注（女性用户） -->
  <view class="period-block" wx:if="{{isFemale}}">
    <view class="period-block-header">
      <view class="period-block-dot"></view>
      <text class="period-block-title">生理期记录</text>
    </view>
    <view class="period-chip-row">
      <view class="period-chip {{dayData.period ? 'period-chip-active' : ''}}" bindtap="onPeriodToggle">今天来月经</view>
      <view class="period-chip {{dayData.periodEnd ? 'period-chip-active' : ''}}" wx:if="{{dayData.period}}" bindtap="onPeriodEndToggle">标记结束</view>
    </view>
    <view class="period-status" wx:if="{{periodStatusText}}">{{periodStatusText}}</view>
    <textarea class="period-note" placeholder="症状/流量备注（如：量多、痛经）" value="{{dayData.periodNote}}" bindinput="onPeriodNoteInput" bindblur="onPeriodNoteBlur" maxlength="200"></textarea>
  </view>

  <!-- 心情日记 -->
  <view class="note-block">
    <view class="note-block-header">
      <view class="note-block-dot"></view>
      <text class="note-block-title">心情日记</text>
    </view>
    <textarea class="note-textarea" placeholder="今天怎么样..." value="{{dayData.note}}" bindinput="onNoteInput" bindblur="onNoteBlur" maxlength="500" auto-height></textarea>
  </view>

  <!-- 100变美日记入口（管理员始终显示，非管理员的已购用户隐藏） -->
  <view class="beauty-entry-card" bindtap="onGoBeauty" wx:if="{{!hideBeautyEntry}}">
    <!-- 光晕 -->
    <view class="beauty-glow beauty-glow-pink"></view>
    <view class="beauty-glow beauty-glow-purple"></view>
    <view class="beauty-entry-inner">
      <!-- 主标题 -->
      <view class="beauty-entry-top">
        <text class="beauty-entry-title">100天变美日记</text>
        <text class="beauty-entry-arrow">›</text>
      </view>
      <!-- 副标题 + 升级版标签 -->
      <view class="beauty-entry-sub-row">
        <text class="beauty-entry-subtitle">UPGRADE · YOUR BEST SELF</text>
        <text class="beauty-entry-badge">升级版</text>
      </view>
      <!-- 功能标签 -->
      <scroll-view class="beauty-features-scroll" scroll-x="true" enhanced show-scrollbar="{{false}}">
        <text class="beauty-feat-chip">护肤日记</text>
        <text class="beauty-feat-chip">心情记录</text>
        <text class="beauty-feat-chip">感恩日记</text>
        <text class="beauty-feat-chip">自律打卡</text>
        <text class="beauty-feat-chip">日历照片</text>
      </scroll-view>
      <!-- 底部 -->
      <view class="beauty-entry-bottom">
        <text class="beauty-entry-subline">一次购买 · 永久会员权益 · 云端储存</text>
        <text class="beauty-entry-subline beauty-entry-hint">点击查看 ›</text>
      </view>
    </view>
  </view>

  <!-- 管理员入口 -->
  <view class="admin-entry-card" wx:if="{{isAdmin}}">
    <view class="admin-entry" bindtap="onGoAdmin">
      <text class="admin-entry-text">⚙️ 管理后台</text>
      <text class="admin-entry-arrow">›</text>
    </view>
  </view>

  <!-- 底部留白 -->
  <view style="height: 120rpx;"></view>

</view>
