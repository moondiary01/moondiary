/* pages/index/index.wxss */
page {
  background: #FAF5FF;
}

.index-page {
  padding-bottom: 40rpx;
}

/* ===== 顶部信息卡 ===== */
.hero-card {
  background: linear-gradient(135deg, #6D28D9 0%, #9333EA 40%, #C026D3 100%);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.22);
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.hero-name {
  font-size: 30rpx;
  font-weight: 700;
}
.hero-date {
  font-size: 24rpx;
  opacity: 0.8;
}
.hero-weight {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.hero-weight-num {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}
.hero-weight-unit {
  font-size: 28rpx;
  opacity: 0.8;
}
.hero-weight-label {
  font-size: 22rpx;
  opacity: 0.65;
  margin-top: 6rpx;
}

/* 体重+入口行 */
.hero-bottom-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
}
.hero-weight-col {
  flex-shrink: 0;
}

/* 已购用户快捷入口 — 靠右 */
.hero-beauty-quick {
  display: flex;
  gap: 14rpx;
  align-items: center;
  flex-shrink: 0;
}
.hero-quick-btn {
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}
.hero-quick-text {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-quick-skincare {
  background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.04));
  color: #e9d5ff;
  border: 1rpx solid rgba(192, 132, 252, 0.3);
  box-shadow: 0 0 14rpx rgba(139, 92, 246, 0.15), inset 0 1rpx 0 rgba(255,255,255,0.08);
}
.hero-quick-mood {
  background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0.04));
  color: #fce7f3;
  border: 1rpx solid rgba(244, 114, 182, 0.3);
  box-shadow: 0 0 14rpx rgba(236, 72, 153, 0.15), inset 0 1rpx 0 rgba(255,255,255,0.08);
}
.hero-quick-btn:active {
  transform: scale(0.94);
  opacity: 0.85;
}

/* ===== 体重 Hero 卡片 ===== */
.weight-hero {
  background: linear-gradient(135deg, #6D28D9 0%, #9333EA 40%, #C026D3 100%);
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.22);
}
.weight-hero-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}
.weight-hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
  flex-shrink: 0;
}
.weight-hero-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  flex: 1;
}
.weight-hero-unit {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.weight-hero-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

/* 晨起输入框：浅黄色边框，白色字体 */
.weight-input-am {
  flex: 1;
  font-size: 36rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.95);
  background: rgba(255,255,255,0.18);
  border: 2rpx solid rgba(254,240,138,0.45);
  border-radius: 16rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  box-sizing: border-box;
}
.weight-input-am::placeholder {
  color: rgba(255,255,255,0.55);
  font-size: 22rpx;
  font-weight: 500;
}

/* 睡前输入框：亮黄色边框，白色字体 */
.weight-input-pm {
  flex: 1;
  font-size: 36rpx;
  font-weight: 800;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.08);
  border: 2rpx solid rgba(250,204,21,0.55);
  border-radius: 16rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  box-sizing: border-box;
}
.weight-input-pm::placeholder {
  color: rgba(255,255,255,0.4);
  font-size: 22rpx;
  font-weight: 500;
}

/* 体脂率内嵌 */
.weight-hero-fat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255,255,255,0.15);
}
.fat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  font-weight: 600;
}
.fat-input {
  width: 160rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid rgba(255,255,255,0.2);
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FACC15;
  text-align: center;
  background: rgba(255,255,255,0.1);
  box-sizing: border-box;
}
.fat-input::placeholder {
  color: rgba(255,255,255,0.3);
  font-size: 26rpx;
  font-weight: 400;
}
.fat-unit {
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.6);
}

/* ===== 喝水打卡 ===== */
.water-block {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(160deg, #F0F9FF 0%, #E0F2FE 40%, #BAE6FD 100%);
  border: 2rpx solid rgba(14, 165, 233, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 24rpx 18rpx;
  box-shadow: 0 2rpx 12rpx rgba(14, 165, 233, 0.06);
}
.water-block-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.water-block-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #38BDF8, #0EA5E9);
  flex-shrink: 0;
}
.water-block-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0369A1;
}
.water-cups-row {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.water-cup {
  width: 64rpx;
  height: 80rpx;
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  border: 3rpx solid #7DD3FC;
  background: transparent;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6rpx;
  font-size: 20rpx;
  color: #0EA5E9;
  font-weight: 700;
}
.water-cup-filled {
  background: linear-gradient(180deg, #38BDF8, #0284C7);
  border-color: #0284C7;
  color: #fff;
  box-shadow: 0 2rpx 8rpx rgba(14, 165, 233, 0.25);
}
.water-info-row {
  font-size: 24rpx;
  color: #0C4A6E;
  margin-top: 10rpx;
}
.water-count-num {
  font-weight: 700;
  color: #0284C7;
}
.water-goal-text {
  font-size: 22rpx;
  color: #7BA5BE;
  margin-top: 4rpx;
}

/* ===== 健康三合一：排便 + 运动 + 饮食 ===== */
.health-trio {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(160deg, #FFFBF0 0%, #FFF7E0 30%, #FFF3CC 60%, #FFEDB3 100%);
  border: 2rpx solid rgba(217, 165, 60, 0.15);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(217, 165, 60, 0.06);
}
.health-trio-row {
  display: flex;
  flex-wrap: wrap;
}
.health-trio-cell {
  width: 50%;
  padding: 24rpx 22rpx;
  border-right: 2rpx solid rgba(217, 165, 60, 0.12);
  border-bottom: 2rpx solid rgba(217, 165, 60, 0.12);
  box-sizing: border-box;
}
.health-trio-cell:nth-child(2n) {
  border-right: none;
}
.health-trio-diet {
  width: 100%;
  border-right: none;
  border-bottom: none;
  background: linear-gradient(160deg, rgba(255,255,255,0.55) 0%, rgba(255,250,240,0.6) 50%, rgba(255,245,225,0.5) 100%);
}
.health-trio-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #B8860B;
  margin-bottom: 14rpx;
  letter-spacing: 0.04em;
}
.health-trio-picker {
  padding: 18rpx 22rpx;
  border: 2rpx solid rgba(217, 165, 60, 0.25);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1917;
  background: rgba(255,255,255,0.75);
}
.health-trio-picker-active {
  color: #B8860B;
  border-color: rgba(217, 165, 60, 0.45);
  background: rgba(255,248,230,0.8);
}

/* 饮食标签 */
.diet-scroll {
  white-space: nowrap;
  width: 100%;
}
.diet-tag-list {
  display: inline-flex;
  gap: 12rpx;
}
.diet-tag {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255,255,255,0.7);
  color: #8B7355;
  border: 2rpx solid rgba(217, 165, 60, 0.2);
  white-space: nowrap;
}
.diet-tag-active {
  background: linear-gradient(135deg, #D4A853, #C9973A);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(184, 134, 11, 0.25);
}

/* ===== 生理期 ===== */
.period-block {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(160deg, #FFF5F5 0%, #FFE4E6 40%, #FECDD3 100%);
  border: 2rpx solid rgba(225, 29, 72, 0.1);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(225, 29, 72, 0.04);
}
.period-block-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.period-block-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FB7185, #E11D48);
  flex-shrink: 0;
}
.period-block-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #9F1239;
}
.period-chip-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.period-chip {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #fff;
  color: #BE123C;
  border: 2rpx solid rgba(225, 29, 72, 0.25);
}
.period-chip-active {
  background: linear-gradient(135deg, #E11D48, #BE123C);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 2rpx 10rpx rgba(225, 29, 72, 0.2);
}
.period-status {
  font-size: 24rpx;
  color: #881337;
  margin-bottom: 12rpx;
}
.period-note {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid rgba(225, 29, 72, 0.15);
  border-radius: 16rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.7);
  box-sizing: border-box;
}

/* ===== 心情日记 ===== */
.note-block {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(160deg, #F8FAFC 0%, #F1F5F9 50%, #E8EEF4 100%);
  border: 2rpx solid rgba(148, 163, 184, 0.15);
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 2rpx 12rpx rgba(100, 116, 139, 0.04);
}
.note-block-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}
.note-block-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #A78BFA, #7C3AED);
  flex-shrink: 0;
}
.note-block-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #4C1D95;
}
.note-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 16rpx;
  font-size: 26rpx;
  background: rgba(255,255,255,0.8);
  box-sizing: border-box;
  line-height: 1.6;
}

/* ===== 100变美日记入口 ===== */
.beauty-entry-card {
  margin: 0 24rpx 20rpx;
  background: linear-gradient(160deg, #1a1025 0%, #2d1b4e 35%, #4c1d6b 65%, #7c3aed 100%);
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(124, 58, 237, 0.25);
}
.beauty-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.beauty-glow-pink {
  top: -50rpx;
  right: -35rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(236, 72, 153, 0.22), transparent 70%);
}
.beauty-glow-purple {
  bottom: -35rpx;
  left: -30rpx;
  width: 170rpx;
  height: 170rpx;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.18), transparent 70%);
}
.beauty-entry-inner { position: relative; z-index: 1; }
/* 主标题 */
.beauty-entry-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.beauty-entry-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 3rpx;
}
.beauty-entry-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  line-height: 1;
}
/* 副标题 + 升级版标签 */
.beauty-entry-sub-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.beauty-entry-subtitle {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 3rpx;
}
.beauty-entry-badge {
  font-size: 22rpx;
  font-weight: 800;
  color: #422006;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  padding: 5rpx 16rpx;
  border-radius: 100rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 0 14rpx rgba(245, 158, 11, 0.4);
}
/* 功能标签 */
.beauty-features-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 22rpx;
}
.beauty-feat-chip {
  display: inline-block;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  margin-right: 10rpx;
}
.beauty-feat-chip:last-child { margin-right: 0; }
/* 底部 */
.beauty-entry-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}
.beauty-entry-subline {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 0.5rpx;
}
.beauty-entry-hint {
  color: rgba(255, 255, 255, 0.25);
}

/* ===== 管理员入口 ===== */
.admin-entry-card {
  margin: 0 24rpx 20rpx;
  background: #fff;
  border: 2rpx solid #EDE4F5;
  border-radius: 20rpx;
  padding: 24rpx;
}
.admin-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.admin-entry-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1917;
}
.admin-entry-arrow {
  font-size: 32rpx;
  color: #a8a29e;
}
