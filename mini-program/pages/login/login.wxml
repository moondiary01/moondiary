<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- Logo -->
  <view class="logo-section">
    <view class="logo-icon">🌙</view>
    <view class="logo-title">Moon Diary</view>
    <view class="logo-subtitle">身材管理日记</view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">微信登录</view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">密钥登录</view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-tab="2">管理员登录</view>
  </view>

  <!-- 微信登录 -->
  <view class="login-content" wx:if="{{currentTab === 0}}">
    <view class="card">
      <view class="login-tip">使用微信快速登录，新用户可免费试用24小时</view>
      <button class="btn btn-primary btn-block wx-login-btn" bindtap="onWxLogin">
        <text class="wx-icon">💚</text>
        <text>微信一键登录</text>
      </button>
    </view>
  </view>

  <!-- 密钥登录 -->
  <view class="login-content" wx:if="{{currentTab === 1}}">
    <view class="card">
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{keyPhone}}" bindinput="onKeyPhoneInput" />
      </view>
      <view class="input-group">
        <text class="input-label">密钥</text>
        <input class="input" type="number" maxlength="6" placeholder="请输入6位密钥" value="{{keyCode}}" bindinput="onKeyCodeInput" />
      </view>
      <button class="btn btn-primary btn-block" bindtap="onKeyLogin">登录</button>
    </view>
  </view>

  <!-- 管理员登录 -->
  <view class="login-content" wx:if="{{currentTab === 2}}">
    <view class="card">
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="请输入管理员手机号" value="{{adminPhone}}" bindinput="onAdminPhoneInput" />
      </view>
      <view class="input-group">
        <text class="input-label">密码</text>
        <input class="input" password="{{true}}" placeholder="请输入密码" value="{{adminPassword}}" bindinput="onAdminPasswordInput" />
      </view>
      <button class="btn btn-primary btn-block" bindtap="onAdminLogin">登录</button>
    </view>
  </view>
</view>
