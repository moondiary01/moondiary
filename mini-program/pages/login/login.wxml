<!-- pages/login/login.wxml -->

<!-- ===== Splash 品牌动画 ===== -->
<view class="splash" wx:if="{{showSplash}}">
  <view class="splash-logo">
    <view class="splash-moon"></view>
  </view>
  <view class="splash-title">
    <text class="splash-brand">Moon Memo</text>
    <text class="splash-sub">月亮日记</text>
  </view>
  <view class="splash-loader">
    <view class="splash-loader-bar"></view>
  </view>
</view>

<view class="login-page" wx:if="{{!showSplash}}">
  <!-- 毛玻璃卡片 -->
  <view class="gate-card">
    <!-- SVG 动画月亮 logo -->
    <view class="moon-logo">
      <view class="moon-glow"></view>
      <view class="moon-crescent"></view>
      <view class="moon-star s1"></view>
      <view class="moon-star s2"></view>
      <view class="moon-star s3"></view>
    </view>
    <view class="gate-title"><text class="brand">MoonMemo</text></view>

    <!-- 用户手机号+密钥登录（默认显示） -->
    <view class="gate-content" wx:if="{{mode === 'user'}}">
      <view class="gate-sub">请输入专属6位密钥进入</view>
      <input class="gate-input gate-input-key" type="number" maxlength="6" placeholder="6位数字密钥" value="{{keyCode}}" bindinput="onKeyCodeInput" />
      <input class="gate-input gate-input-phone" type="number" maxlength="11" placeholder="手机号（11位）" value="{{keyPhone}}" bindinput="onKeyPhoneInput" />
      <button class="gate-btn" bindtap="onKeyLogin">进 入</button>
      <view class="gate-hint">绑定微信可直接登陆，若需密钥登陆请联系管理员\n一个手机号只能绑定一个密钥</view>
      <view class="gate-switch-link" bindtap="switchMode" data-mode="admin">管理员入口</view>
    </view>

    <!-- 管理员手机号+密码登录（隐藏） -->
    <view class="gate-content" wx:if="{{mode === 'admin'}}">
      <view class="gate-sub">管理员登录</view>
      <input class="gate-input gate-input-phone" type="number" maxlength="11" placeholder="管理员手机号" value="{{adminPhone}}" bindinput="onAdminPhoneInput" />
      <input class="gate-input" type="text" password="{{true}}" placeholder="管理员密码" value="{{adminPassword}}" bindinput="onAdminPasswordInput" />
      <button class="gate-btn" bindtap="onAdminLogin">管理员进入</button>
      <view class="gate-hint">请输入管理员手机号与密码</view>
      <view class="gate-switch-link" bindtap="switchMode" data-mode="user">← 返回用户登录</view>
    </view>
  </view>
</view>
