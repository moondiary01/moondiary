<!-- pages/login/login.wxml -->

<!-- ===== Splash 品牌动画 ===== -->
<view class="splash" wx:if="{{showSplash}}">
  <view class="splash-logo">
    <view class="splash-moon"></view>
  </view>
  <view class="splash-title">
    <text class="splash-brand">Moon Memo</text>
    <text class="splash-sub">月亮日记</text>
  </view>
  <view class="splash-loader">
    <view class="splash-loader-bar"></view>
  </view>
</view>

<view class="login-page" wx:if="{{!showSplash}}">
  <!-- 毛玻璃卡片 -->
  <view class="gate-card">
    <!-- SVG 动画月亮 logo -->
    <view class="moon-logo">
      <view class="moon-glow"></view>
      <view class="moon-crescent"></view>
      <view class="moon-star s1"></view>
      <view class="moon-star s2"></view>
      <view class="moon-star s3"></view>
    </view>
    <view class="gate-title"><text class="brand">MoonMemo</text></view>

    <!-- ===== 用户登录区域 ===== -->
    <view class="gate-content" wx:if="{{mode === 'user'}}">
      <!-- Tabs -->
      <view class="gate-tabs">
        <view class="gate-tab {{loginTab === 'sms' ? 'active' : ''}}" bindtap="switchLoginTab" data-tab="sms">手机验证码</view>
        <view class="gate-tab {{loginTab === 'wx' ? 'active' : ''}}" bindtap="switchLoginTab" data-tab="wx">微信登录</view>
      </view>

      <!-- 手机验证码登录 -->
      <view wx:if="{{loginTab === 'sms'}}">
        <input class="gate-input" type="number" maxlength="11" placeholder="手机号" placeholder-class="gate-input-placeholder" value="{{loginPhone}}" bindinput="onLoginPhoneInput" />
        <view class="sms-row">
          <input class="gate-input gate-input-code" type="number" maxlength="6" placeholder="验证码" placeholder-class="gate-input-placeholder" value="{{smsCode}}" bindinput="onSmsCodeInput" />
          <button class="sms-btn" bindtap="sendSmsCode" disabled="{{smsCooldown > 0}}">{{smsBtnText}}</button>
        </view>
        <view class="gate-error" wx:if="{{gateError}}">{{gateError}}</view>
        <button class="gate-btn" hover-class="gate-btn-hover" bindtap="smsLogin">登 录</button>
        <view class="gate-hint">首次登录自动注册，所有用户均可免费试用7天</view>
      </view>

      <!-- 微信登录 -->
      <view wx:if="{{loginTab === 'wx'}}">
        <view class="wx-login-box">
          <view class="wx-icon-btn" bindtap="wxLogin" hover-class="wx-icon-btn-hover">W</view>
          <view class="wx-login-hint">点击微信图标授权登录</view>
          <view class="wx-login-desc">授权后自动获取微信绑定手机号\n首次登录自动注册，免费试用7天</view>
        </view>
        <view class="gate-error" wx:if="{{wxError}}">{{wxError}}</view>
      </view>

      <view class="gate-switch-link" bindtap="switchMode" data-mode="admin">管理员入口</view>
    </view>

    <!-- ===== 管理员登录区域 ===== -->
    <view class="gate-content" wx:if="{{mode === 'admin'}}">
      <view class="gate-sub">管理员登录</view>

      <!-- Tabs -->
      <view class="gate-tabs">
        <view class="gate-tab {{adminLoginTab === 'sms' ? 'active' : ''}}" bindtap="switchAdminLoginTab" data-tab="sms">验证码登录</view>
        <view class="gate-tab {{adminLoginTab === 'code' ? 'active' : ''}}" bindtap="switchAdminLoginTab" data-tab="code">激活码登录</view>
      </view>

      <!-- 验证码登录 -->
      <view wx:if="{{adminLoginTab === 'sms'}}">
        <input class="gate-input" type="number" maxlength="11" placeholder="管理员手机号" placeholder-class="gate-input-placeholder" value="{{adminPhone}}" bindinput="onAdminPhoneInput" />
        <view class="sms-row">
          <input class="gate-input gate-input-code" type="number" maxlength="6" placeholder="验证码" placeholder-class="gate-input-placeholder" value="{{adminSmsCode}}" bindinput="onAdminSmsCodeInput" />
          <button class="sms-btn" bindtap="sendAdminSmsCode" disabled="{{adminSmsCooldown > 0}}">{{adminSmsBtnText}}</button>
        </view>
        <view class="gate-error" wx:if="{{adminError}}">{{adminError}}</view>
        <button class="gate-btn" hover-class="gate-btn-hover" bindtap="adminSmsLogin">管理员登录</button>
      </view>

      <!-- 激活码登录 -->
      <view wx:if="{{adminLoginTab === 'code'}}">
        <input class="gate-input" type="number" maxlength="11" placeholder="管理员手机号" placeholder-class="gate-input-placeholder" value="{{adminCodePhone}}" bindinput="onAdminCodePhoneInput" />
        <input class="gate-input gate-input-key" type="number" maxlength="6" placeholder="管理员激活码" placeholder-class="gate-input-placeholder" value="{{adminActivationCode}}" bindinput="onAdminActivationCodeInput" />
        <view class="gate-error" wx:if="{{adminCodeError}}">{{adminCodeError}}</view>
        <button class="gate-btn" hover-class="gate-btn-hover" bindtap="adminCodeLogin">激活码登录</button>
      </view>

      <view class="gate-hint">管理员手机号 18680881810 · 激活码 151601</view>
      <view class="gate-switch-link" bindtap="switchMode" data-mode="user">← 返回用户登录</view>
    </view>
  </view>
</view>
