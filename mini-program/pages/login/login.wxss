/* ===== Splash 品牌动画 ===== */
.splash {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--grad-hero);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 600;
  animation: splashFade 2.8s ease forwards;
}
@keyframes splashFade {
  0% { opacity: 1; }
  85% { opacity: 1; }
  100% { opacity: 0; visibility: hidden; }
}

.splash-logo {
  width: 200rpx;
  height: 200rpx;
  margin-top: -120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: splashLogoIn 0.8s cubic-bezier(0.34,1.56,0.64,1), splashLogoSpin 3s ease-in-out, splashFloat 2s ease-in-out 0.8s infinite;
}
@keyframes splashLogoIn {
  from { transform: scale(0) rotate(-180deg); opacity: 0; }
  to { transform: scale(1) rotate(0); opacity: 1; }
}
@keyframes splashLogoSpin {
  0% { transform: rotate(0); }
  100% { transform: rotate(360deg); }
}
@keyframes splashFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-24rpx); }
}

/* CSS 月牙 — Splash 用 */
.splash-moon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED 0%, #C026D3 50%, #EC4899 100%);
  position: relative;
  box-shadow: 0 8rpx 48rpx rgba(255,255,255,0.25);
}
.splash-moon::after {
  content: '';
  position: absolute;
  top: -16rpx;
  right: -36rpx;
  width: 144rpx;
  height: 192rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6D28D9, #9333EA);
}

.splash-title {
  color: #fff;
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  margin-top: 40rpx;
  animation: splashTextIn 0.6s 0.3s ease both;
  font-style: italic;
  text-shadow: 0 8rpx 40rpx rgba(0,0,0,0.2);
  text-align: center;
  line-height: 1.3;
}
.splash-brand {
  font-size: 56rpx;
  font-weight: 900;
  display: block;
}
.splash-sub {
  color: rgba(255,255,255,0.85);
  font-size: 28rpx;
  font-weight: 400;
  font-style: normal;
  display: block;
  animation: splashTextIn 0.6s 0.5s ease both;
}
@keyframes splashTextIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.splash-loader {
  width: 400rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  margin-top: 60rpx;
  overflow: hidden;
  animation: splashTextIn 0.6s 0.7s ease both;
}
.splash-loader-bar {
  height: 100%;
  background: linear-gradient(90deg, transparent, #fff, transparent);
  animation: loaderSlide 1.2s ease-in-out infinite;
}
@keyframes loaderSlide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ===== 登录页面 ===== */
  min-height: 100vh;
  background: linear-gradient(135deg, #6D28D9 0%, #9333EA 30%, #C026D3 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}
/* 背景光晕 */
.login-page::before {
  content: '';
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  top: -200rpx;
  right: -150rpx;
  animation: float 8s ease-in-out infinite;
}
.login-page::after {
  content: '';
  position: absolute;
  width: 450rpx;
  height: 450rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(201,168,118,0.15) 0%, transparent 70%);
  bottom: -120rpx;
  left: -100rpx;
  animation: float 10s ease-in-out infinite reverse;
}
@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(30rpx, -20rpx) scale(1.05); }
}

/* ===== 毛玻璃卡片 ===== */
.gate-card {
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 60rpx 48rpx 48rpx;
  max-width: 700rpx;
  width: 100%;
  box-shadow: 0 32rpx 80rpx rgba(26,21,48,0.3), 0 0 0 2rpx rgba(255,255,255,0.2) inset;
  text-align: center;
  position: relative;
  z-index: 1;
}

/* ===== 月亮 Logo（CSS 绘制） ===== */
.moon-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 8rpx;
  position: relative;
  animation: logoSpin 20s linear infinite;
  filter: drop-shadow(0 8rpx 32rpx rgba(147,51,234,0.3));
}
@keyframes logoSpin {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}

/* 光晕 */
.moon-glow {
  position: absolute;
  inset: -20rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(168,85,247,0.25) 0%, transparent 65%);
  animation: glowPulse 3s ease-in-out infinite;
}
@keyframes glowPulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.75; transform: scale(1.12); }
}

/* 月牙 — 紫粉渐变圆形 + 白色圆形覆盖右侧形成月牙 */
.moon-crescent {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED 0%, #C026D3 50%, #EC4899 100%);
}
/* 右侧白色遮罩挖出月牙形状 */
.moon-crescent::after {
  content: '';
  position: absolute;
  top: -12rpx;
  right: -28rpx;
  width: 112rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #fff;
}

/* 金色星星 */
.moon-star {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574, #E8C9A0);
}
.moon-star.s1 {
  width: 12rpx;
  height: 12rpx;
  top: 24rpx;
  right: 20rpx;
}
.moon-star.s2 {
  width: 9rpx;
  height: 9rpx;
  top: 60rpx;
  right: 8rpx;
  opacity: 0.7;
}
.moon-star.s3 {
  width: 10rpx;
  height: 10rpx;
  top: 100rpx;
  right: 28rpx;
  opacity: 0.8;
}

/* ===== 品牌标题 ===== */
.gate-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #1c1917;
  margin-bottom: 36rpx;
  letter-spacing: -1rpx;
}
.gate-title .brand {
  background: linear-gradient(135deg, var(--rose-600), var(--coral));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-style: italic;
  font-weight: 900;
  font-size: 50rpx;
}

/* ===== 登录内容 ===== */
.gate-content {
  position: relative;
  z-index: 1;
}
.gate-sub {
  font-size: 26rpx;
  color: #78716c;
  margin-bottom: 36rpx;
}

/* 输入框 */
.gate-input {
  width: 100%;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  padding: 28rpx;
  border: 3rpx solid #e7e5e4;
  border-radius: 16rpx;
  outline: none;
  color: #e11d48;
  background: #fff1f2;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.gate-input-key {
  letter-spacing: 12rpx;
}
.gate-input-phone {
  letter-spacing: 6rpx;
  font-size: 32rpx;
}

/* 按钮 */
.gate-btn {
  width: 100%;
  margin-top: 20rpx;
  padding: 28rpx;
  border: none;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #7C3AED, #C026D3);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  box-shadow: 0 8rpx 32rpx rgba(147,51,234,0.25);
}

/* 提示文字 */
.gate-hint {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 24rpx;
  line-height: 1.6;
  white-space: pre-line;
}

/* 管理员入口链接 */
.gate-switch-link {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #a8a29e;
  opacity: 0.6;
}
