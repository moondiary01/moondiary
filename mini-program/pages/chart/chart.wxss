/* pages/chart/chart.wxss */
.chart-page {
  padding-bottom: 40rpx;
}

/* 图例 */
.chart-legend {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #78716c;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-morning { background: #ec4899; }
.legend-evening { background: #fbcfe8; }
.legend-fat { background: #fbbf24; }

/* Canvas */
.chart-canvas {
  width: 100%;
  height: 400rpx;
}
.chart-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #a8a29e;
  font-size: 26rpx;
}

/* BMI */
.bmi-card {
  display: flex;
  align-items: center;
}
.bmi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.bmi-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.bmi-label {
  font-size: 28rpx;
  color: #78716c;
}
.bmi-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #1c1917;
}
.bmi-status {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.bmi-thin { background: #dbeafe; color: #2563eb; }
.bmi-normal { background: #dcfce7; color: #16a34a; }
.bmi-over { background: #fef3c7; color: #d97706; }
.bmi-obese { background: #fee2e2; color: #dc2626; }

/* 三围 */
.measure-row {
  display: flex;
  gap: 20rpx;
}
.measure-item {
  flex: 1;
  text-align: center;
  background: #faf5f9;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
}
.measure-label {
  font-size: 24rpx;
  color: #78716c;
  display: block;
  margin-bottom: 8rpx;
}
.measure-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1917;
}
.measure-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #a8a29e;
}
