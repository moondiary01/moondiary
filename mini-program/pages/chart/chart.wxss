/* pages/chart/chart.wxss */
.chart-page {
  padding-bottom: 40rpx;
}

/* 图例 */
.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-l);
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-morning { background: #C026D3; }
.legend-evening { background: #ec4899; }
.legend-fat { background: #F59E0B; }
.legend-period { background: #D4A574; }
.legend-period-zone { background: rgba(236,72,153,0.15); border: 2rpx solid rgba(236,72,153,0.3); }

/* Canvas */
.chart-canvas {
  width: 100%;
  height: 420rpx;
}
.chart-bar-canvas {
  width: 100%;
  height: 240rpx;
}
.chart-empty {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-l);
  font-size: 26rpx;
}

/* BMI 环形图 */
.bmi-row-new {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.bmi-ring-wrap {
  flex-shrink: 0;
}
.bmi-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 10rpx solid var(--rose-100);
  position: relative;
}
.bmi-ring.bmi-thin { border-color: #93c5fd; background: #eff6ff; }
.bmi-ring.bmi-normal { border-color: #86efac; background: #f0fdf4; }
.bmi-ring.bmi-over { border-color: #fcd34d; background: #fffbeb; }
.bmi-ring.bmi-obese { border-color: #fca5a5; background: #fef2f2; }
.bmi-ring-num {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--ink);
  line-height: 1;
}
.bmi-ring-lbl {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-l);
  margin-top: 4rpx;
}
.bmi-info-right {
  flex: 1;
}
.bmi-cat {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}
.bmi-desc {
  font-size: 24rpx;
  color: var(--text-l);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

/* BMI 分类标签 */
.bmi-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.bmi-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.bmi-tag-thin { background: #fef3c7; color: #d97706; }
.bmi-tag-normal { background: #ecfdf5; color: #059669; }
.bmi-tag-over { background: #fef3c7; color: #d97706; }
.bmi-tag-obese { background: #fef2f2; color: #dc2626; }

/* 数据统计网格 10项 2列 */
.stat-grid-new {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}
.stat-item {
  text-align: center;
  padding: 18rpx 8rpx;
  background: var(--card);
  border-radius: 24rpx;
  border: 1px solid var(--border);
}
.dash-clickable {
  cursor: pointer;
}
.stat-val {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--rose-600);
  line-height: 1.2;
}
.stat-lbl {
  font-size: 20rpx;
  color: var(--text-l);
  margin-top: 6rpx;
  display: block;
}
.stat-val.coral { color: var(--rose-500); }
.stat-val.amber { color: #FF8C00; }
.stat-val.mint { color: var(--mint); }
.stat-val.pink { color: var(--coral); }
.stat-val.rose { color: var(--rose-600); }
.stat-val.gold { color: var(--gold-d); }
