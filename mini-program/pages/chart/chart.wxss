/* pages/chart/chart.wxss */
.chart-page {
  padding-bottom: 40rpx;
}

/* 图例 */
.chart-legend {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #78716c;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.legend-morning { background: #ec4899; }
.legend-evening { background: #fbcfe8; }
.legend-fat { background: #fbbf24; }

/* Canvas */
.chart-canvas {
  width: 100%;
  height: 400rpx;
}
.chart-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #a8a29e;
  font-size: 26rpx;
}

/* BMI */
.bmi-card {
  display: flex;
  align-items: center;
}
.bmi-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.bmi-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.bmi-label {
  font-size: 28rpx;
  color: #78716c;
}
.bmi-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #1c1917;
}
.bmi-status {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.bmi-thin { background: #dbeafe; color: #2563eb; }
.bmi-normal { background: #dcfce7; color: #16a34a; }
.bmi-over { background: #fef3c7; color: #d97706; }
.bmi-obese { background: #fee2e2; color: #dc2626; }

/* 三围 */
.measure-row {
  display: flex;
  gap: 20rpx;
}
.measure-item {
  flex: 1;
  text-align: center;
  background: #faf5f9;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
}
.measure-label {
  font-size: 24rpx;
  color: #78716c;
  display: block;
  margin-bottom: 8rpx;
}
.measure-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1917;
}
.measure-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #a8a29e;
}

/* BMI 分类标签 */
.bmi-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}
.bmi-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.bmi-tag-thin { background: #fef3c7; color: #d97706; }
.bmi-tag-normal { background: #ecfdf5; color: #059669; }
.bmi-tag-over { background: #fef3c7; color: #d97706; }
.bmi-tag-obese { background: #fef2f2; color: #dc2626; }

/* 数据统计网格 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.stat-item {
  text-align: center;
  padding: 18rpx 8rpx;
  background: #faf5ff;
  border-radius: 12rpx;
}
.stat-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #1c1917;
  line-height: 1.2;
}
.stat-lbl {
  font-size: 20rpx;
  color: #a8a29e;
  margin-top: 6rpx;
}
.stat-val.amber { color: #d97706; }
.stat-val.mint { color: #10b981; }
.stat-val.pink { color: #ec4899; }
.stat-val.rose { color: #be185d; }
.stat-val.coral { color: #f97316; }
