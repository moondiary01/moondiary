<!-- pages/chart/chart.wxml -->
<view class="chart-page">

  <!-- 体重趋势图 -->
  <view class="card">
    <view class="card-title">体重趋势</view>
    <view class="chart-legend">
      <view class="legend-item">
        <view class="legend-dot legend-morning"></view>
        <text>晨起体重</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-evening"></view>
        <text>晚间体重</text>
      </view>
      <view class="legend-item">
        <view class="legend-dot legend-fat"></view>
        <text>体脂率</text>
      </view>
    </view>
    <canvas canvas-id="weightChart" id="weightChart" class="chart-canvas"></canvas>
    <view class="chart-empty" wx:if="{{!hasData}}">
      <text>暂无体重数据，去记录吧~</text>
    </view>
  </view>

  <!-- BMI 显示 -->
  <view class="card bmi-card">
    <view class="bmi-row">
      <view class="bmi-info">
        <text class="bmi-label">BMI</text>
        <text class="bmi-value">{{bmiValue || '--'}}</text>
      </view>
      <view class="bmi-status {{bmiClass}}">{{bmiStatus}}</view>
    </view>
    <!-- BMI 分类标签 -->
    <view class="bmi-tags">
      <text class="bmi-tag bmi-tag-thin">偏瘦 &lt;18.5</text>
      <text class="bmi-tag bmi-tag-normal">正常 18.5-23.9</text>
      <text class="bmi-tag bmi-tag-over">偏胖 24-27.9</text>
      <text class="bmi-tag bmi-tag-obese">肥胖 ≥28</text>
    </view>
  </view>

  <!-- 三围记录 -->
  <view class="card">
    <view class="card-title">三围记录</view>
    <view class="measure-row">
      <view class="measure-item" bindtap="onEditMeasure" data-field="bust">
        <text class="measure-label">胸围</text>
        <text class="measure-value">{{bust || '--'}} <text class="measure-unit">cm</text></text>
      </view>
      <view class="measure-item" bindtap="onEditMeasure" data-field="waist">
        <text class="measure-label">腰围</text>
        <text class="measure-value">{{waist || '--'}} <text class="measure-unit">cm</text></text>
      </view>
      <view class="measure-item" bindtap="onEditMeasure" data-field="hip">
        <text class="measure-label">臀围</text>
        <text class="measure-value">{{hip || '--'}} <text class="measure-unit">cm</text></text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="card">
    <view class="card-title">📊 数据统计</view>
    <view class="stat-grid">
      <view class="stat-item">
        <text class="stat-val amber">{{statMaxWeight || '—'}}</text>
        <text class="stat-lbl">最高体重</text>
      </view>
      <view class="stat-item">
        <text class="stat-val mint">{{statMinWeight || '—'}}</text>
        <text class="stat-lbl">最低体重</text>
      </view>
      <view class="stat-item">
        <text class="stat-val">{{statAvgWeight || '—'}}</text>
        <text class="stat-lbl">平均体重</text>
      </view>
      <view class="stat-item">
        <text class="stat-val pink">{{statRecordDays || 0}}</text>
        <text class="stat-lbl">记录天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-val rose">{{bmiValue || '—'}}</text>
        <text class="stat-lbl">当前BMI</text>
      </view>
      <view class="stat-item">
        <text class="stat-val coral">{{statRemain || '—'}}</text>
        <text class="stat-lbl">距目标还差</text>
      </view>
      <view class="stat-item">
        <text class="stat-val amber">{{statStartFat || '—'}}</text>
        <text class="stat-lbl">起始体脂率</text>
      </view>
      <view class="stat-item">
        <text class="stat-val amber">{{statLatestFat || '—'}}</text>
        <text class="stat-lbl">最新体脂率</text>
      </view>
      <view class="stat-item">
        <text class="stat-val mint">{{statFatDiff || '—'}}</text>
        <text class="stat-lbl">体脂变化</text>
      </view>
    </view>
  </view>

</view>

<!-- 编辑三围弹窗 -->
<view class="overlay" wx:if="{{showEditModal}}" bindtap="onCloseModal">
  <view class="modal" catchtap="">
    <view class="modal-title">{{editLabel}}</view>
    <view class="input-group">
      <input class="input" type="digit" placeholder="请输入数值(cm)" value="{{editValue}}" bindinput="onEditValueInput" />
    </view>
    <view class="modal-actions">
      <button class="btn btn-outline" bindtap="onCloseModal">取消</button>
      <button class="btn btn-primary" bindtap="onConfirmEdit">确认</button>
    </view>
  </view>
</view>
