<!-- pages/review/review.wxml -->
<view class="review-page">
  <view class="review-tip">每周复盘你的变化，记录感受与调整策略</view>
  
  <block wx:for="{{weekList}}" wx:key="week">
    <view class="card review-card" style="background: {{item.bg}};">
      <view class="review-header">
        <text class="review-week-num">第{{item.weekNum}}周</text>
        <text class="review-week-date">{{item.dateRange}}</text>
      </view>
      <view class="review-stats">
        <view class="review-stat">
          <text class="review-stat-label">周一</text>
          <text class="review-stat-val">{{item.mondayWeight}}</text>
        </view>
        <view class="review-stat">
          <text class="review-stat-label">周日</text>
          <text class="review-stat-val">{{item.sundayWeight}}</text>
        </view>
        <view class="review-stat">
          <text class="review-stat-label">本周变化</text>
          <text class="review-stat-val {{item.weekChangeColor}}">{{item.weekChange}}</text>
        </view>
        <view class="review-stat">
          <text class="review-stat-label">累计变化</text>
          <text class="review-stat-val {{item.totalChangeColor}}">{{item.totalChange}}</text>
        </view>
        <view class="review-stat">
          <text class="review-stat-label">记录</text>
          <text class="review-stat-val">{{item.recordDays}}</text>
        </view>
        <view class="review-stat" wx:if="{{item.periodDays > 0}}">
          <text class="review-stat-label">经期</text>
          <text class="review-stat-val review-stat-period">{{item.periodDays}}天</text>
        </view>
        <view class="review-stat">
          <text class="review-stat-label">日均水</text>
          <text class="review-stat-val review-stat-water">{{item.waterAvg}}ml</text>
        </view>
      </view>
      <textarea 
        class="review-textarea" 
        placeholder="本周感想/调整..." 
        value="{{item.review}}"
        data-week="{{index}}"
        bindinput="onReviewInput"
      ></textarea>
      <button class="btn btn-primary review-save-btn" data-week="{{index}}" bindtap="saveReview">保存</button>
    </view>
  </block>

  <view class="review-export-bar" wx:if="{{weekList.length > 0}}">
    <button class="btn btn-primary" bindtap="exportReviewImage"> 导出复盘报表图片</button>
  </view>

  <view wx:if="{{weekList.length === 0}}" class="review-empty">
    <text>暂无复盘数据，请先设置计划开始日期并记录体重</text>
  </view>
</view>
