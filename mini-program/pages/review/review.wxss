/* pages/review/review.wxss */
.review-page {
  padding-bottom: 40rpx;
}
.review-tip {
  text-align: center;
  font-size: 26rpx;
  color: var(--text-l);
  padding: 20rpx;
}

/* 导出按钮 */
.export-bar {
  display: flex;
  justify-content: flex-end;
  padding: 0 24rpx 8rpx;
}
.export-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

/* 每周卡片 */
.review-week-card {
  position: relative;
  overflow: hidden;
}
.review-week-card.stage-s1 {
  border-left: 6rpx solid var(--rose-300);
}
.review-week-card.stage-s2 {
  border-left: 6rpx solid var(--rose-500);
}
.review-week-card.stage-s3 {
  border-left: 6rpx solid var(--rose-700);
}

.week-header {
  margin-bottom: 16rpx;
}
.week-title-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.week-num {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}
.week-date {
  font-size: 24rpx;
  color: var(--text-l);
}
.week-stage {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--rose-100);
  color: var(--rose-600);
  font-weight: 600;
  margin-left: auto;
}

/* 每周统计网格 */
.week-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.week-stat-item {
  text-align: center;
  padding: 10rpx 4rpx;
  background: var(--rose-50);
  border-radius: 16rpx;
}
.week-stat-lbl {
  font-size: 20rpx;
  color: var(--text-l);
  display: block;
  margin-bottom: 4rpx;
}
.week-stat-val {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.week-stat-val.good { color: var(--mint); }
.week-stat-val.bad { color: #ef4444; }

/* 文本框 */
.textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #fafaf9;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { font-size: 30rpx; color: var(--text-l); display: block; margin-bottom: 8rpx; }
.empty-sub { font-size: 24rpx; color: #c4b5fd; display: block; }

/* 保存 */
.save-area {
  padding: 20rpx 24rpx;
}

/* 导出弹窗 */
.export-modal {
  width: 90%;
  max-height: 70vh;
}
.export-preview {
  padding: 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.export-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--rose-600);
  text-align: center;
}
.export-subtitle {
  font-size: 24rpx;
  color: var(--text-l);
  text-align: center;
  margin-top: 4rpx;
}
.export-divider {
  height: 2rpx;
  background: var(--border);
  margin: 16rpx 0;
}
.export-week-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.export-week-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 6rpx;
}
.export-week-review {
  font-size: 24rpx;
  color: var(--text-l);
  line-height: 1.6;
}
