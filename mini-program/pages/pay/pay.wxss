/* pages/pay/pay.wxss */
.pay-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 头部 */
.pay-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.pay-header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.pay-header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1917;
}

/* Tab切换 */
.pay-tabs {
  display: flex;
  margin: 0 24rpx 24rpx;
  gap: 16rpx;
}

.pay-tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #78716c;
  border-radius: 16rpx;
  background: #f5f5f4;
  transition: all 0.2s;
}

.tab-active {
  color: #fff;
  background: linear-gradient(135deg, #ec4899, #f43f5e);
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.3);
}

/* 价格卡片 */
.price-card {
  text-align: center;
}

.price-card-basic {
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
}

.price-card-upgrade {
  background: linear-gradient(135deg, #ede9fe, #fce7f3, #fef3c7);
  position: relative;
  overflow: hidden;
}

.upgrade-badge {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.price-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #ec4899;
}

.price-card-upgrade .price-amount {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.price-desc {
  font-size: 28rpx;
  color: #78716c;
  margin-top: 12rpx;
}

/* 权益列表 */
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.benefit-section {
  font-size: 30rpx;
  font-weight: 700;
  color: #8b5cf6;
  margin-top: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f5f3ff;
}

.benefit-section:first-child {
  margin-top: 0;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.benefit-icon {
  font-size: 32rpx;
}
.benefit-text {
  font-size: 28rpx;
  color: #44403c;
}

/* 入口按钮 */
.entry-btn {
  font-size: 28rpx;
  color: #ec4899;
  padding: 24rpx 0;
  text-align: center;
  border-bottom: 2rpx solid #f3f4f6;
}
.entry-btn:last-child {
  border-bottom: none;
}

/* 底部支付 */
.pay-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.pay-btn {
  font-size: 32rpx;
  padding: 24rpx 0;
}

.pay-btn-upgrade {
  background: linear-gradient(135deg, #8b5cf6, #ec4899) !important;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.3);
}
