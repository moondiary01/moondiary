/* pages/pay/pay.wxss */
.pay-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 20rpx 0 40rpx;
}

/* Tab */
.pay-tabs {
  display: flex;
  margin: 0 32rpx 20rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: var(--shadow);
}
.pay-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-l);
  border-radius: 20rpx;
  transition: all 0.2s;
}
.pay-tab.active {
  background: var(--grad-hero);
  color: #fff;
}

/* 付费卡片 */
.pay-content {
  padding: 0 32rpx;
}
.pay-card {
  background: var(--card);
  border-radius: 40rpx;
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
  box-shadow: var(--shadow-lg);
  border: 2rpx solid var(--border);
}
.pay-card-upgrade {
  border-color: var(--rose-300);
  box-shadow: 0 32rpx 80rpx rgba(124,58,237,0.15);
}
.pay-card-header {
  margin-bottom: 32rpx;
}
.pay-card-title {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--ink);
  display: block;
  line-height: 1;
}
.pay-card-sub {
  font-size: 32rpx;
  color: var(--text-l);
  display: block;
  margin-top: 8rpx;
  font-weight: 600;
}

/* 权益 */
.pay-benefits {
  text-align: left;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: var(--rose-50);
  border-radius: 24rpx;
}
.pay-benefit-item {
  font-size: 28rpx;
  color: var(--text);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--rose-200);
}
.pay-benefit-item:last-child {
  border-bottom: none;
}

/* 按钮 */
.pay-btn {
  width: 100%;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}
.pay-btn-upgrade {
  background: linear-gradient(135deg, #8b5cf6, #ec4899) !important;
  box-shadow: 0 8rpx 32rpx rgba(139,92,246,0.35);
}

.pay-note {
  font-size: 24rpx;
  color: var(--text-l);
  letter-spacing: 1rpx;
}

/* 链接 */
.pay-links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 32rpx;
}
.pay-link {
  font-size: 26rpx;
  color: var(--rose-600);
  text-decoration: underline;
}

/* 须知弹窗 */
.notice-content {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.8;
}
.notice-section {
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}
.notice-bold {
  font-weight: 700;
  color: var(--ink);
}
.notice-item {
  padding-left: 24rpx;
  margin-bottom: 6rpx;
}
