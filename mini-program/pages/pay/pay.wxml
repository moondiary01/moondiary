<!-- pages/pay/pay.wxml -->
<view class="pay-page">
  <!-- Tab 切换 -->
  <view class="pay-tabs">
    <view class="pay-tab {{currentTab === 0 ? 'active' : ''}}" bindtap="switchPayTab" data-tab="0">基础版</view>
    <view class="pay-tab {{currentTab === 1 ? 'active' : ''}}" bindtap="switchPayTab" data-tab="1">升级版</view>
  </view>

  <!-- 基础版 -->
  <view class="pay-content" wx:if="{{currentTab === 0}}">
    <view class="pay-card">
      <view class="pay-card-header">
        <text class="pay-card-title">19.9元</text>
        <text class="pay-card-sub">永久普通版</text>
      </view>
      <view class="pay-benefits">
        <view class="pay-benefit-item"> 全部功能解锁</view>
        <view class="pay-benefit-item"> 云端数据同步</view>
        <view class="pay-benefit-item"> 经期日历</view>
        <view class="pay-benefit-item"> 照片上传</view>
        <view class="pay-benefit-item"> 数据导出</view>
      </view>
      <button class="btn btn-primary pay-btn" bindtap="onBasicPay">立即开通 19.9元</button>
      <view class="pay-note">一次购买 · 永久有效 · 云端储存</view>
    </view>
  </view>

  <!-- 升级版 -->
  <view class="pay-content" wx:if="{{currentTab === 1}}">
    <view class="pay-card pay-card-upgrade">
      <view class="pay-card-header">
        <text class="pay-card-title">29.9元</text>
        <text class="pay-card-sub">永久升级版</text>
      </view>
      <view class="pay-benefits">
        <view class="pay-benefit-item"> 基础版全部功能</view>
        <view class="pay-benefit-item"> 护肤日记（肤质管理/打卡/美容院记录）</view>
        <view class="pay-benefit-item"> 心情日记（35种心情/冥想音乐/自律打卡）</view>
        <view class="pay-benefit-item"> 感恩日记</view>
        <view class="pay-benefit-item"> 日历照片</view>
      </view>
      <button class="btn btn-primary pay-btn pay-btn-upgrade" bindtap="onBeautyPay">立即开通 29.9元</button>
      <view class="pay-note">一次购买 · 永久会员权益 · 云端储存</view>
    </view>
  </view>

  <!-- 购买须知 / 隐私说明 -->
  <view class="pay-links">
    <text class="pay-link" bindtap="showPurchaseNotice">购买须知</text>
    <text class="pay-link" bindtap="showPrivacyNotice">隐私说明</text>
  </view>
</view>

<!-- 购买须知弹窗 -->
<view class="overlay" wx:if="{{showNoticeModal}}" bindtap="closeNoticeModal">
  <view class="modal" catchtap>
    <view class="modal-title">购买须知</view>
    <scroll-view scroll-y style="max-height:60vh">
      <view class="notice-content">
        <view class="notice-section"><text class="notice-bold">1. 会员档位</text></view>
        <view class="notice-item">• 19.9元 永久普通版：永久云端存储 + 趋势图表 + 周度复盘，不含护肤日记/心情日记功能。</view>
        <view class="notice-item">• 29.9元 永久升级版：包含云端存储 + 100天变美计划（护肤日记、心情日记），永久有效。</view>
        <view class="notice-section"><text class="notice-bold">2. 退款政策</text></view>
        <view class="notice-item">• 数字商品一经开通，不支持退款。</view>
        <view class="notice-section"><text class="notice-bold">3. 使用期限</text></view>
        <view class="notice-item">• 均为永久有效，一次购买终身使用。</view>
        <view class="notice-item">• 无限期权益仅在本小程序正常运营存续期间内有效。</view>
        <view class="notice-section"><text class="notice-bold">4. 开通方式</text></view>
        <view class="notice-item">• 联系管理员手动开通，开通后立即生效。</view>
        <view class="notice-section"><text class="notice-bold">5. 数据安全</text></view>
        <view class="notice-item">• 您的数据仅存储在您的个人云端空间，其他用户无法访问。</view>
      </view>
    </scroll-view>
    <view class="modal-actions">
      <button class="btn btn-outline" bindtap="closeNoticeModal">关闭</button>
      <button class="btn btn-primary" style="background:linear-gradient(135deg,#8b5cf6,#ec4899);border:none" bindtap="confirmPurchase">我已阅读并同意 · 确认开通</button>
    </view>
  </view>
</view>

<!-- 隐私说明弹窗 -->
<view class="overlay" wx:if="{{showPrivacyModal}}" bindtap="closePrivacyModal">
  <view class="modal" catchtap>
    <view class="modal-title">隐私说明</view>
    <scroll-view scroll-y style="max-height:60vh">
      <view class="notice-content">
        <view class="notice-section"><text class="notice-bold">1. 数据收集</text></view>
        <view class="notice-item">• 我们仅收集您主动输入的身材数据、护肤记录、心情日记及自拍照片。</view>
        <view class="notice-item">• 手机号仅用于身份识别和数据绑定，不向第三方分享。</view>
        <view class="notice-section"><text class="notice-bold">2. 数据存储</text></view>
        <view class="notice-item">• 您的数据存储在加密的云端服务器（腾讯云COS），仅您本人可访问。</view>
        <view class="notice-item">• 照片数据经压缩处理后存储，不会用于其他用途。</view>
        <view class="notice-section"><text class="notice-bold">3. 数据隔离</text></view>
        <view class="notice-item">• 每个用户的数据独立存储，互不可见。一手机号一份数据。</view>
        <view class="notice-section"><text class="notice-bold">4. 数据删除</text></view>
        <view class="notice-item">• 您可随时联系管理员删除所有个人数据。</view>
        <view class="notice-section"><text class="notice-bold">5. 联系方式</text></view>
        <view class="notice-item">• 如有隐私相关问题，请联系管理员处理。</view>
      </view>
    </scroll-view>
    <view class="modal-actions">
      <button class="btn btn-primary" bindtap="closePrivacyModal">我知道了</button>
    </view>
  </view>
</view>
