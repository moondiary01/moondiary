/* pages/plan/plan.wxss */
.plan-page {
  padding-bottom: 40rpx;
}

/* 信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.info-cell {
  width: 46%;
  background: #faf5f9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.info-label {
  font-size: 24rpx;
  color: #78716c;
  display: block;
  margin-bottom: 6rpx;
}
.info-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.edit-hint {
  text-align: right;
  font-size: 24rpx;
  color: #ec4899;
  margin-top: 16rpx;
}

/* 三围 */
.measure-row {
  display: flex;
  gap: 20rpx;
}
.measure-cell {
  flex: 1;
  text-align: center;
  background: #faf5f9;
  border-radius: 16rpx;
  padding: 24rpx 10rpx;
}
.measure-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1c1917;
  display: block;
}
.measure-lbl {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 4rpx;
}

/* 进度 */
.progress-list {
  margin-bottom: 20rpx;
}
.progress-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f4;
}
.progress-item:last-child {
  border-bottom: none;
}
.progress-label {
  font-size: 28rpx;
  color: #78716c;
}
.progress-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1917;
}
.progress-good { color: #16a34a; }
.progress-bad { color: #dc2626; }

/* 进度条 */
.progress-bar-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
}
.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #f5f5f4;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #f43f5e, #ec4899);
  border-radius: 8rpx;
  transition: width 0.3s;
}
.progress-percent {
  font-size: 24rpx;
  color: #ec4899;
  font-weight: 600;
}

/* 性别按钮 */
.gender-row {
  display: flex;
  gap: 20rpx;
}
.gender-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border: 3rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #78716c;
}
.gender-active {
  border-color: #ec4899;
  background: #fce7f3;
  color: #ec4899;
  font-weight: 600;
}

/* Picker */
.picker-value {
  padding: 20rpx 24rpx;
  border: 3rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1c1917;
  background: #fff;
}
