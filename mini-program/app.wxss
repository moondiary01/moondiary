/* ===== MoonMemo 月亮日记 全局样式 ===== */
page {
  background: #faf5f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #1c1917;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 主题色 */
.theme-rose { color: #ec4899; }
.theme-rose-bg { background: #fce7f3; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1917;
  margin-bottom: 20rpx;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 36rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.15s;
}
.btn-primary {
  background: linear-gradient(135deg, #f43f5e, #ec4899);
  color: #fff;
}
.btn-outline {
  background: transparent;
  color: #ec4899;
  border: 3rpx solid #f9a8d4;
}
.btn-danger {
  background: #ef4444;
  color: #fff;
}
.btn-block {
  width: 100%;
  display: flex;
}

/* 输入框 */
.input {
  width: 100%;
  padding: 20rpx 24rpx;
  border: 3rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #fff;
  color: #1c1917;
  box-sizing: border-box;
}
.input-group {
  margin-bottom: 20rpx;
}
.input-label {
  font-size: 26rpx;
  color: #78716c;
  margin-bottom: 8rpx;
  display: block;
}

/* Toast */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(28,25,23,0.85);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  z-index: 999;
  pointer-events: none;
}

/* 遮罩层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(28,25,23,0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 弹窗 */
.modal {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx;
  width: 85%;
  max-height: 80vh;
  overflow-y: auto;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 30rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
  margin-top: 30rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.tag-active {
  background: #fce7f3;
  color: #ec4899;
}

/* 文字辅助 */
.text-sm { font-size: 24rpx; }
.text-md { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-xl { font-size: 40rpx; }
.text-light { color: #78716c; }
.text-center { text-align: center; }
.text-bold { font-weight: 700; }
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }

/* ===== 升级版公共样式 ===== */
.upgrade-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #8b5cf6, #a78bfa);
  color: #fff;
  letter-spacing: 1rpx;
}
.upgrade-gradient {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
}
.upgrade-card {
  background: linear-gradient(135deg, #fdf2f8, #f5f3ff);
  border: 2rpx solid #e9d5ff;
}
.beauty-title {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.check-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #f5f5f4;
  font-size: 28rpx;
  transition: all 0.15s;
}
.check-item-active {
  background: linear-gradient(135deg, #fce7f3, #f5f3ff);
  color: #8b5cf6;
  font-weight: 600;
}
.check-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 3rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.check-circle-active {
  background: #8b5cf6;
  border-color: #8b5cf6;
  color: #fff;
}
