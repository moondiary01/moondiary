<!-- components/pay-modal/pay-modal.wxml -->
<view class="overlay" wx:if="{{show}}" bindtap="onClose">
  <view class="modal pay-modal" catchtap="">
    <view class="pay-modal-icon">🔒</view>
    <view class="modal-title">试用已结束</view>
    <view class="pay-modal-desc">您的24小时试用已结束，开通会员继续使用全部功能</view>
    <view class="pay-modal-price">19.9元 永久使用云存储</view>
    <view class="pay-modal-actions">
      <view class="pay-modal-link" bindtap="onNotice">查看购买须知</view>
      <view class="pay-modal-link" bindtap="onPrivacy">查看隐私政策</view>
    </view>
    <button class="btn btn-primary btn-block pay-modal-btn" bindtap="onPay">立即开通</button>
  </view>
</view>
