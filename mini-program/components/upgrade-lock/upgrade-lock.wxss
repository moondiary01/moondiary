/* components/upgrade-lock/upgrade-lock.wxss */

.upgrade-lock-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upgrade-lock-modal {
  width: 580rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.2);
}

.upgrade-lock-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.upgrade-lock-title {
  font-size: 36rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  -webkit-background-clip: text;
  color: transparent;
  margin-bottom: 20rpx;
}

.upgrade-lock-desc {
  font-size: 26rpx;
  color: #78716c;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 28rpx;
}

.upgrade-lock-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #8b5cf6;
  margin-bottom: 32rpx;
}

.upgrade-lock-close {
  font-size: 28rpx;
  color: #a8a29e;
  margin-top: 20rpx;
  padding: 16rpx 0;
  text-align: center;
}

.upgrade-lock-close:active {
  color: #78716c;
}
