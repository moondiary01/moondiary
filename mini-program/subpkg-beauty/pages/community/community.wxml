<upgrade-lock show="{{!canUseUpgrade}}" />

<view class="community-page">

  <!-- ===== 月友圈 Feed ===== -->
  <view wx:if="{{currentTab === 'feed'}}" class="feed-view">
    <view class="feed-header">
      <text class="feed-header-title">🌙 月友圈</text>
      <text class="feed-header-sub">分享变美心得 · 互相鼓励</text>
    </view>

    <view class="post-list" wx:if="{{posts.length > 0}}">
      <view wx:for="{{posts}}" wx:key="id" class="post-card">
        <!-- 用户信息 -->
        <view class="post-header" data-userkey="{{item.userKey}}" bindtap="onTapUser">
          <view class="post-avatar-wrap">
            <image wx:if="{{item.avatar}}" class="post-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view wx:else class="post-avatar-default">{{item.nickname[0] || '月'}}</view>
          </view>
          <view class="post-user-info">
            <text class="post-nickname">{{item.nickname}}</text>
            <view class="post-meta">
              <text wx:if="{{item.gender}}" class="post-gender">{{item.gender === '男' ? '♂' : '♀'}}</text>
              <text wx:if="{{item.age}}" class="post-age">{{item.age}}岁</text>
              <text class="post-time">{{item.timeText}}</text>
            </view>
          </view>
        </view>

        <!-- 内容 -->
        <view wx:if="{{item.content}}" class="post-content" data-id="{{item.id}}" bindtap="onTapPost">{{item.content}}</view>

        <!-- 图片 -->
        <view wx:if="{{item.images.length > 0}}" class="post-images {{item.images.length === 1 ? 'single-img' : ''}}" data-id="{{item.id}}" bindtap="onTapPost">
          <view wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="post-img-thumb" data-src="{{img}}" data-urls="{{item.images}}" catchtap="onPreviewImage">
            <image src="{{img}}" mode="aspectFill" />
          </view>
        </view>

        <!-- 互动栏 -->
        <view class="post-actions">
          <view class="post-action" data-id="{{item.id}}" catchtap="onLikePost">
            <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="action-count">{{item.likeCount || 0}}</text>
          </view>
          <view class="post-action" data-id="{{item.id}}" catchtap="onTapPost">
            <text class="action-icon">💬</text>
            <text class="action-count">{{item.commentCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{posts.length === 0 && !loading}}">
      <text class="empty-icon">🌙</text>
      <text class="empty-text">还没有内容，快去发布第一条吧</text>
    </view>
  </view>

  <!-- ===== 发布 ===== -->
  <view wx:if="{{currentTab === 'post'}}" class="post-view">
    <view class="post-editor">
      <view class="editor-title">✏️ 发布动态</view>
      <view class="my-profile-preview">
        <view class="post-avatar-wrap">
          <image wx:if="{{myProfile.avatar}}" class="post-avatar" src="{{myProfile.avatar}}" mode="aspectFill" />
          <view wx:else class="post-avatar-default">{{myProfile.nickname[0] || '月'}}</view>
        </view>
        <view>
          <text class="post-nickname">{{myProfile.nickname}}</text>
          <text class="my-profile-hint">将以此身份发布</text>
        </view>
      </view>
      <textarea class="editor-textarea" placeholder="分享你的变美心得、护肤经验、心情故事..." value="{{postContent}}" bindinput="onPostContentInput" maxlength="500" auto-height />
      <view class="editor-char-count">{{postContent.length}}/500</view>
      <view class="editor-images">
        <block wx:for="{{postImages}}" wx:key="*this">
          <view class="editor-img-thumb">
            <image src="{{item}}" mode="aspectFill" />
            <view class="editor-img-delete" data-index="{{index}}" catchtap="onDeleteImage">×</view>
          </view>
        </block>
        <view wx:if="{{postImages.length < 9}}" class="editor-img-add" bindtap="onAddImage">
          <text class="editor-add-icon">+</text>
          <text class="editor-add-text">添加图片</text>
        </view>
      </view>
      <button class="publish-btn" bindtap="onPublishPost">发布</button>
    </view>
  </view>

  <!-- ===== 我的 ===== -->
  <view wx:if="{{currentTab === 'mine'}}" class="mine-view">
    <view class="profile-card">
      <view class="profile-header">
        <view class="profile-avatar-wrap" bindtap="onChangeAvatar">
          <image wx:if="{{myProfile.avatar}}" class="profile-avatar" src="{{myProfile.avatar}}" mode="aspectFill" />
          <view wx:else class="profile-avatar-default">{{myProfile.nickname[0] || '月'}}</view>
        </view>
        <view class="profile-info">
          <view class="profile-name-row">
            <text class="profile-nickname">{{myProfile.nickname}}</text>
            <view wx:if="{{!editingProfile}}" class="profile-edit-btn" bindtap="onEditProfile">编辑</view>
          </view>
          <view class="profile-meta">
            <text wx:if="{{myProfile.gender}}" class="profile-meta-item">{{myProfile.gender}}</text>
            <text wx:if="{{myProfile.age}}" class="profile-meta-item">{{myProfile.age}}岁</text>
          </view>
          <text wx:if="{{myProfile.signature}}" class="profile-signature">{{myProfile.signature}}</text>
        </view>
      </view>
      <view wx:if="{{editingProfile}}" class="profile-edit-form">
        <view class="edit-form-row"><text class="edit-label">昵称</text><input class="edit-input" value="{{myProfile.nickname}}" data-field="nickname" bindinput="onProfileInput" placeholder="你的昵称" maxlength="20" /></view>
        <view class="edit-form-row"><text class="edit-label">性别</text><view class="edit-gender-row"><view class="edit-gender-opt {{myProfile.gender === '男' ? 'gender-active' : ''}}" data-value="男" bindtap="onProfileGender">男</view><view class="edit-gender-opt {{myProfile.gender === '女' ? 'gender-active' : ''}}" data-value="女" bindtap="onProfileGender">女</view></view></view>
        <view class="edit-form-row"><text class="edit-label">年龄</text><input class="edit-input" type="number" value="{{myProfile.age}}" data-field="age" bindinput="onProfileInput" placeholder="年龄" /></view>
        <view class="edit-form-row"><text class="edit-label">签名</text><input class="edit-input" value="{{myProfile.signature}}" data-field="signature" bindinput="onProfileInput" placeholder="一句话介绍自己" maxlength="50" /></view>
        <view class="edit-form-actions"><button class="btn-cancel" bindtap="onCancelEditProfile">取消</button><button class="btn-save" bindtap="saveMyProfile">保存</button></view>
      </view>
    </view>
    <view class="my-posts-section">
      <view class="my-posts-title">我的动态 {{myPosts.length}}</view>
      <view wx:if="{{myPosts.length === 0}}" class="empty-state"><text class="empty-text">还没有发布过动态</text></view>
      <view wx:for="{{myPosts}}" wx:key="id" class="post-card">
        <view class="post-content" data-id="{{item.id}}" bindtap="onTapPost">{{item.content}}</view>
        <view wx:if="{{item.images.length > 0}}" class="post-images">
          <view wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="post-img-thumb" data-src="{{img}}" data-urls="{{item.images}}" catchtap="onPreviewImage">
            <image src="{{img}}" mode="aspectFill" />
          </view>
        </view>
        <view class="post-actions">
          <text class="post-time">{{item.timeText}}</text>
          <view class="post-action" data-id="{{item.id}}" catchtap="onLikePost">
            <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
            <text class="action-count">{{item.likeCount || 0}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view style="height:140rpx"></view>
</view>

<!-- 底部Tab栏 -->
<view class="bottom-tab-bar">
  <view class="tab-item {{currentTab === 'feed' ? 'tab-active' : ''}}" data-tab="feed" bindtap="onTabChange">
    <text class="tab-icon">🌙</text>
    <text class="tab-label">月友圈</text>
  </view>
  <view class="tab-item {{currentTab === 'notice' ? 'tab-active' : ''}}" data-tab="notice" bindtap="onTabChange">
    <view style="position:relative;display:inline-block">
      <text class="tab-icon">🔔</text>
      <view wx:if="{{noticeUnread > 0}}" style="position:absolute;top:-8rpx;right:-16rpx;background:#ec4899;color:#fff;font-size:18rpx;min-width:28rpx;height:28rpx;line-height:28rpx;border-radius:14rpx;text-align:center;padding:0 6rpx;font-weight:700">{{noticeUnread > 99 ? '99+' : noticeUnread}}</view>
    </view>
    <text class="tab-label">通知</text>
  </view>
  <view class="tab-item tab-item-center {{currentTab === 'post' ? 'tab-active' : ''}}" data-tab="post" bindtap="onTabChange">
    <view class="tab-center-btn">
      <text class="tab-icon">✏️</text>
      <text class="tab-label">发布</text>
    </view>
  </view>
  <view class="tab-item {{currentTab === 'mine' ? 'tab-active' : ''}}" data-tab="mine" bindtap="onTabChange">
    <text class="tab-icon">👤</text>
    <text class="tab-label">我的</text>
  </view>
</view>
