/* subpkg-beauty/pages/community/community.wxss */

.community-page {
  min-height: 100vh;
  background: #faf5f9;
  padding-bottom: 160rpx;
}

/* ===== Feed头部 ===== */
.feed-header {
  background: linear-gradient(135deg, #8b5cf6, #ec4899, #f43f5e);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feed-header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.feed-header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* ===== 帖子列表 ===== */
.post-list {
  padding: 20rpx 24rpx;
}

.post-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

/* 用户信息 */
.post-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.post-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-avatar {
  width: 100%;
  height: 100%;
}

.post-avatar-default {
  font-size: 36rpx;
  font-weight: 700;
  color: #8b5cf6;
}

.post-user-info {
  flex: 1;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
  display: block;
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.post-gender {
  font-size: 24rpx;
  color: #8b5cf6;
}

.post-age {
  font-size: 24rpx;
  color: #a8a29e;
}

.post-time {
  font-size: 24rpx;
  color: #a8a29e;
}

/* 帖子内容 */
.post-content {
  font-size: 30rpx;
  color: #44403c;
  line-height: 1.7;
  margin-bottom: 20rpx;
  word-break: break-all;
}

/* 帖子图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.post-img-thumb {
  width: calc(33.33% - 6rpx);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.post-images.single-img .post-img-thumb {
  width: 400rpx;
  aspect-ratio: 4/3;
}

.post-img-thumb image {
  width: 100%;
  height: 100%;
}

/* 互动栏 */
.post-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 40rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f4;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-count {
  font-size: 26rpx;
  color: #78716c;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a8a29e;
}

/* ===== 发布页面 ===== */
.post-view {
  padding: 24rpx;
}

.post-editor {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.editor-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1917;
  margin-bottom: 24rpx;
}

.my-profile-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #f5f3ff;
  border-radius: 16rpx;
}

.my-profile-preview .post-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
}

.my-profile-hint {
  font-size: 22rpx;
  color: #a8a29e;
  display: block;
}

.editor-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f5f5f4;
  font-size: 30rpx;
  color: #44403c;
  line-height: 1.6;
  border: none;
}

.editor-char-count {
  text-align: right;
  font-size: 22rpx;
  color: #c8c4c0;
  margin-top: 8rpx;
}

.editor-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.editor-img-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.editor-img-thumb image {
  width: 100%;
  height: 100%;
}

.editor-img-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.editor-img-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f5f5f4;
  border: 3rpx dashed #d6d3d1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.editor-add-icon {
  font-size: 48rpx;
  color: #c8c4c0;
}

.editor-add-text {
  font-size: 22rpx;
  color: #a8a29e;
}

.publish-btn {
  width: 100%;
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.3);
}

/* ===== 我的页面 ===== */
.mine-view {
  padding: 24rpx;
}

.profile-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.profile-header {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.profile-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-avatar-default {
  font-size: 48rpx;
  font-weight: 700;
  color: #8b5cf6;
}

.profile-info {
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1917;
}

.profile-edit-btn {
  font-size: 24rpx;
  color: #8b5cf6;
  padding: 6rpx 24rpx;
  border: 2rpx solid #8b5cf6;
  border-radius: 100rpx;
}

.profile-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.profile-meta-item {
  font-size: 26rpx;
  color: #78716c;
}

.profile-signature {
  font-size: 26rpx;
  color: #a8a29e;
  margin-top: 8rpx;
  display: block;
}

/* 编辑表单 */
.profile-edit-form {
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f4;
}

.edit-form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.edit-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
  width: 80rpx;
  flex-shrink: 0;
}

.edit-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #f5f5f4;
  font-size: 28rpx;
  color: #44403c;
}

.edit-gender-row {
  display: flex;
  gap: 12rpx;
  flex: 1;
}

.edit-gender-opt {
  padding: 12rpx 40rpx;
  border-radius: 100rpx;
  background: #f5f5f4;
  font-size: 28rpx;
  color: #78716c;
}

.gender-active {
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-weight: 600;
}

.edit-form-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 100rpx;
  background: #f5f5f4;
  color: #78716c;
}

.btn-save {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
}

/* 我的历史动态 */
.my-posts-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.my-posts-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1917;
  margin-bottom: 24rpx;
}

/* ===== 底部Tab栏 ===== */
.bottom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #f5f5f4;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
  z-index: 100;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex: 1;
}

.tab-item-center {
  position: relative;
}

.tab-center-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  margin-top: -30rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.4);
}

.tab-center-btn .tab-icon {
  font-size: 36rpx;
}

.tab-center-btn .tab-label {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
}

.tab-icon {
  font-size: 36rpx;
}

.tab-label {
  font-size: 22rpx;
  color: #a8a29e;
  font-weight: 500;
}

.tab-active .tab-icon {
  transform: scale(1.1);
}

.tab-active .tab-label {
  color: #8b5cf6;
  font-weight: 600;
}
