/* subpkg-beauty/pages/upgrade-home/upgrade-home.wxss */

.upgrade-page {
  min-height: 100vh;
  background: #faf5f9;
  padding-bottom: 160rpx;
}

/* ===== 顶部 Banner ===== */
.upgrade-banner {
  position: relative;
  margin: 24rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.upgrade-banner-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  opacity: 1;
  z-index: 0;
}

.upgrade-banner-content {
  position: relative;
  z-index: 1;
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upgrade-banner-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upgrade-banner-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.upgrade-banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 6rpx;
  font-weight: 500;
}

/* ===== 栏目入口 ===== */
.upgrade-sections {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.upgrade-section-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s, box-shadow 0.15s;
}

.upgrade-section-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* 图标背景圈 */
.section-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-icon-skincare {
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
}

.section-icon-mood {
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
}

.section-icon {
  font-size: 40rpx;
}

/* 栏目信息 */
.section-info {
  flex: 1;
  min-width: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1917;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: #78716c;
  line-height: 1.5;
}

/* 箭头 */
.section-arrow {
  font-size: 44rpx;
  color: #8b5cf6;
  flex-shrink: 0;
  font-weight: 300;
}

/* ===== 底部价格 ===== */
.upgrade-footer {
  padding: 48rpx 24rpx 60rpx;
  display: flex;
  justify-content: center;
}

.upgrade-price-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upgrade-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #8b5cf6;
  margin-bottom: 8rpx;
}

.upgrade-price-desc {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ===== 功能亮点标签 ===== */
.upgrade-features {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  padding: 12rpx 24rpx 0;
}

.feature-tag {
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.feature-tag-purple { background: rgba(139, 92, 246, 0.08); color: #7c3aed; }
.feature-tag-pink { background: rgba(236, 72, 153, 0.08); color: #ec4899; }
.feature-tag-amber { background: rgba(217, 119, 6, 0.08); color: #d97706; }
.feature-tag-green { background: rgba(5, 150, 105, 0.08); color: #059669; }
.feature-tag-blue { background: rgba(2, 132, 199, 0.08); color: #0284c7; }
