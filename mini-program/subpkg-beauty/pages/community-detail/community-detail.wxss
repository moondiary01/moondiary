/* subpkg-beauty/pages/community-detail/community-detail.wxss */

.detail-page, .profile-page {
  min-height: 100vh;
  background: #faf5f9;
  padding-bottom: 140rpx;
}

/* ===== 帖子详情卡片 ===== */
.post-detail-card {
  background: #fff;
  border-radius: 0 0 24rpx 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.post-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.post-avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-avatar {
  width: 100%;
  height: 100%;
}

.post-avatar-default {
  font-size: 36rpx;
  font-weight: 700;
  color: #8b5cf6;
}

.post-user-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.post-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.post-time {
  font-size: 24rpx;
  color: #a8a29e;
}

.post-content {
  font-size: 32rpx;
  color: #44403c;
  line-height: 1.8;
  margin-bottom: 24rpx;
  word-break: break-all;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.post-images .post-img-thumb {
  width: calc(33.33% - 6rpx);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.post-images.single-img .post-img-thumb {
  width: 400rpx;
  aspect-ratio: 4/3;
}

.post-img-thumb image {
  width: 100%;
  height: 100%;
}

.post-actions {
  display: flex;
  gap: 48rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f4;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-count {
  font-size: 26rpx;
  color: #78716c;
  font-weight: 500;
}

/* ===== 评论区 ===== */
.comments-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.comments-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1917;
  margin-bottom: 28rpx;
}

.no-comments {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.no-comments-text {
  font-size: 28rpx;
  color: #a8a29e;
}

.comment-item {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.comment-item:last-child {
  margin-bottom: 0;
}

.comment-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-avatar {
  width: 100%;
  height: 100%;
}

.comment-avatar-default {
  font-size: 28rpx;
  font-weight: 700;
  color: #8b5cf6;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.comment-nickname {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
}

.comment-time {
  font-size: 22rpx;
  color: #a8a29e;
}

.comment-content {
  font-size: 30rpx;
  color: #44403c;
  line-height: 1.6;
}

.reply-hint {
  color: #8b5cf6;
  font-size: 26rpx;
  margin-right: 8rpx;
}

.comment-reply-btn {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a8a29e;
  padding: 4rpx 0;
}

.bottom-space {
  height: 120rpx;
}

/* ===== 加载中 ===== */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #a8a29e;
}

/* ===== 底部评论栏 ===== */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid #f5f5f4;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 100rpx;
  background: #f5f5f4;
  font-size: 28rpx;
  color: #44403c;
}

.comment-send-btn {
  padding: 16rpx 36rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #8b5cf6, #ec4899);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* ===== 用户主页 ===== */
.profile-detail-card {
  background: #fff;
  border-radius: 0 0 24rpx 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.profile-detail-header {
  display: flex;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

.profile-avatar-lg-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f5f3ff, #fce7f3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar-lg {
  width: 100%;
  height: 100%;
}

.profile-avatar-lg-default {
  font-size: 56rpx;
  font-weight: 700;
  color: #8b5cf6;
}

.profile-detail-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.profile-detail-nick {
  font-size: 38rpx;
  font-weight: 700;
  color: #1c1917;
}

.profile-detail-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.profile-detail-sig {
  font-size: 26rpx;
  color: #a8a29e;
  margin-top: 8rpx;
}

.profile-post-count {
  font-size: 28rpx;
  color: #78716c;
  font-weight: 600;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f4;
}

.profile-posts {
  padding: 0 24rpx;
}

.profile-posts .post-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.profile-posts .post-content {
  font-size: 30rpx;
  color: #44403c;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.profile-posts .post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.profile-posts .post-img-thumb {
  width: calc(33.33% - 6rpx);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
}

.profile-posts .post-img-thumb image {
  width: 100%;
  height: 100%;
}

.profile-posts .post-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f4;
}

.profile-posts .post-time {
  font-size: 24rpx;
  color: #a8a29e;
}

.profile-posts .post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.profile-posts .action-icon {
  font-size: 32rpx;
}

.profile-posts .action-count {
  font-size: 24rpx;
  color: #78716c;
}

/* 帖子详情中的用户信息 */
.post-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.post-gender {
  font-size: 24rpx;
  color: #8b5cf6;
}

.post-age {
  font-size: 24rpx;
  color: #a8a29e;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  gap: 12rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a8a29e;
}
