<!-- 帖子详情模式 -->
<view wx:if="{{viewMode === 'detail' && post}}" class="detail-page">
  <view class="post-detail-card">
    <view class="post-header">
      <view class="post-avatar-wrap">
        <image wx:if="{{post.avatar}}" class="post-avatar" src="{{post.avatar}}" mode="aspectFill" />
        <view wx:else class="post-avatar-default">{{post.nickname[0] || '月'}}</view>
      </view>
      <view class="post-user-info">
        <text class="post-nickname">{{post.nickname}}</text>
        <view class="post-meta">
          <text wx:if="{{post.gender}}" class="post-gender">{{post.gender === '男' ? '♂' : '♀'}}</text>
          <text wx:if="{{post.age}}" class="post-age">{{post.age}}岁</text>
          <text class="post-time">{{post.timeText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{post.content}}" class="post-content">{{post.content}}</view>

    <view wx:if="{{post.images.length > 0}}" class="post-images {{post.images.length === 1 ? 'single-img' : ''}}">
      <view wx:for="{{post.images}}" wx:for-item="img" wx:key="*this" class="post-img-thumb" data-src="{{img}}" bindtap="onPreviewImage">
        <image src="{{img}}" mode="aspectFill" />
      </view>
    </view>

    <view class="post-actions">
      <view class="post-action" bindtap="onLikePost">
        <text class="action-icon">{{post.isLiked ? '❤️' : '🤍'}}</text>
        <text class="action-count">{{post.likeCount || 0}}</text>
      </view>
      <view class="post-action">
        <text class="action-icon">💬</text>
        <text class="action-count">{{comments.length}}</text>
      </view>
    </view>
  </view>

  <!-- 评论区 -->
  <view class="comments-section">
    <view class="comments-title">评论 {{comments.length}}</view>
    <view wx:if="{{comments.length === 0}}" class="no-comments">
      <text class="no-comments-text">还没有评论，来说点什么吧</text>
    </view>
    <view wx:for="{{comments}}" wx:key="id" class="comment-item">
      <view class="comment-avatar-wrap">
        <image wx:if="{{item.avatar}}" class="comment-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="comment-avatar-default">{{item.nickname[0] || '月'}}</view>
      </view>
      <view class="comment-body">
        <view class="comment-header">
          <text class="comment-nickname">{{item.nickname}}</text>
          <text class="comment-time">{{item.timeText}}</text>
        </view>
        <view class="comment-content">
          <text wx:if="{{item.replyTo}}" class="reply-hint">回复</text>
          {{item.content}}
        </view>
        <view class="comment-reply-btn" data-cid="{{item.id}}" data-nickname="{{item.nickname}}" bindtap="onReplyComment">回复</view>
      </view>
    </view>
  </view>

  <view style="height:120rpx"></view>

  <!-- 底部评论栏 -->
  <view class="comment-bar">
    <input class="comment-input" placeholder="{{replyPlaceholder}}" value="{{commentText}}" bindinput="onCommentInput" bindfocus="onFocusComment" confirm-type="send" bindconfirm="onSendComment" />
    <view class="comment-send-btn" bindtap="onSendComment">发送</view>
  </view>
</view>

<!-- 用户主页模式 -->
<view wx:if="{{viewMode === 'profile' && profileData}}" class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="profile-detail-card">
    <view class="profile-detail-header">
      <view class="profile-avatar-lg-wrap">
        <image wx:if="{{profileData.avatar}}" class="profile-avatar-lg" src="{{profileData.avatar}}" mode="aspectFill" />
        <view wx:else class="profile-avatar-lg-default">{{profileData.nickname[0] || '月'}}</view>
      </view>
      <view class="profile-detail-info">
        <text class="profile-detail-nick">{{profileData.nickname}}</text>
        <view class="profile-detail-meta">
          <text wx:if="{{profileData.gender}}" class="profile-meta-item">{{profileData.gender}}</text>
          <text wx:if="{{profileData.age}}" class="profile-meta-item">{{profileData.age}}岁</text>
        </view>
        <text wx:if="{{profileData.signature}}" class="profile-detail-sig">{{profileData.signature}}</text>
      </view>
    </view>
    <view class="profile-post-count">动态 {{profilePosts.length}}</view>
  </view>

  <!-- 用户动态列表 -->
  <view class="profile-posts">
    <view wx:if="{{profilePosts.length === 0}}" class="empty-state">
      <text class="empty-text">还没有发布动态</text>
    </view>
    <view wx:for="{{profilePosts}}" wx:key="id" class="post-card" data-id="{{item.id}}" bindtap="onTapPost">
      <view class="post-content">{{item.content}}</view>
      <view wx:if="{{item.images.length > 0}}" class="post-images">
        <view wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" class="post-img-thumb" data-src="{{img}}" data-urls="{{item.images}}" catchtap="onPreviewImageInProfile">
          <image src="{{img}}" mode="aspectFill" />
        </view>
      </view>
      <view class="post-actions">
        <text class="post-time">{{item.timeText}}</text>
        <view class="post-action">
          <text class="action-icon">❤️</text>
          <text class="action-count">{{item.likeCount || 0}}</text>
        </view>
      </view>
    </view>
  </view>
  <view style="height:40rpx"></view>
</view>

<!-- 加载中 -->
<view wx:if="{{loading}}" class="loading-state">
  <text class="loading-text">加载中...</text>
</view>
