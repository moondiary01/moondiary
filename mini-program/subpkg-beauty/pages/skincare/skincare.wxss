/* subpkg-beauty/pages/skincare/skincare.wxss */

.skincare-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #faf8ff 0%, #f5f0fa 30%, #faf5ff 60%, #fdf2f8 100%);
  padding-bottom: 60rpx;
}

/* ===== 倒计时卡片 ===== */
.countdown-card {
  position: relative;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d1b4e 50%, #4a1942 100%);
  margin: 24rpx 24rpx;
  border-radius: 32rpx;
  padding: 52rpx 40rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(26, 26, 46, 0.45), 0 6rpx 16rpx rgba(74, 25, 66, 0.25), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.08);
}

/* ===== 今日皮肤状态 — 浅粉紫色渐变背景 ===== */
.skin-section {
  background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 50%, #f5f3ff 100%);
  border-radius: 32rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
}
.skin-section .card-title-text {
  color: #be185d;
}
/* 皮肤胶囊 — 同色系玫瑰红 */
.skin-tag {
  padding: 12rpx 32rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #fce7f3, #fbcfe8);
  font-size: 26rpx;
  color: #be185d;
  font-weight: 500;
  border: 2rpx solid #ec4899;
  transition: all 0.2s;
}
.skin-tag-active {
  background: linear-gradient(135deg, #ec4899, #db2777);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(236, 72, 153, 0.3);
  border-color: transparent;
}
.skin-custom-input {
  width: 100%;
  padding: 20rpx 28rpx;
  border: 2rpx solid #ec4899;
  border-radius: 24rpx;
  font-size: 28rpx;
  background: rgba(255,255,255,0.6);
  color: #be185d;
  box-sizing: border-box;
}

/* ===== 今日打卡 — 浅紫色渐变背景 ===== */
.check-section {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 50%, #f3e8ff 100%);
  border-radius: 32rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
}
.check-section .card-title-text {
  color: #7c3aed;
}
/* 打卡胶囊 — 紫色系 */
.bodycare-tag {
  padding: 12rpx 32rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #ede9fe, #ddd6fe);
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 500;
  border: 2rpx solid #8b5cf6;
  transition: all 0.2s;
}
.bodycare-tag-active {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.3);
  border-color: transparent;
}

/* 美容院/do脸 — 紫色外框 + 黑色字体 */
.check-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ede9fe;
}
.check-row:last-child { border-bottom: none; }
.check-icon-label {
  font-size: 30rpx;
  color: #1c1917;
  font-weight: 500;
}
.check-box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  border: 3rpx solid #8b5cf6;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.6);
}
.check-on .check-box {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(139, 92, 246, 0.3);
}
.check-on .check-icon-label {
  color: #7c3aed;
  font-weight: 600;
}
.check-tick {
  font-size: 28rpx;
  color: #fff;
  font-weight: 800;
}

/* 备注 — 透明背景 + 黑色字体 */
.note-section {
  margin: 0 24rpx 20rpx;
}
.note-section .card-title-text {
  color: #1c1917;
}
.note-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: transparent;
  font-size: 28rpx;
  color: #1c1917;
  line-height: 1.6;
  border: 2rpx solid #d6d3d1;
}
.special-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: transparent;
  font-size: 28rpx;
  color: #1c1917;
  line-height: 1.6;
  border: 2rpx solid #c4b5fd;
  margin-top: 12rpx;
}
.custom-check-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 90rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: transparent;
  font-size: 28rpx;
  color: #1c1917;
  line-height: 1.6;
  border: 2rpx solid #c4b5fd;
  margin-bottom: 12rpx;
}

/* ===== 卡片通用 ===== */
.skincare-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.03);
  border: none;
}
.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.card-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 标签行 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.tag-item {
  padding: 12rpx 32rpx;
  border-radius: 100rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s;
}
.tag-active {
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(236, 72, 153, 0.25);
  border-color: transparent;
}

/* ===== 摘要卡片 ===== */
.summary-card {
  padding: 20rpx 24rpx;
  margin: 0 24rpx 20rpx;
}
.summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.summary-tag {
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.summary-check {
  background: linear-gradient(135deg, #fdf2f8, #fce7f3);
  color: #be185d;
  border: 1rpx solid #fbcfe8;
}
.summary-body {
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  color: #6d28d9;
  border: 1rpx solid #ddd6fe;
}

/* ===== 护肤日历 ===== */
.cal-hint {
  font-size: 24rpx;
  color: #a8a29e;
  margin-bottom: 20rpx;
  text-align: center;
}
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 24rpx;
}
.cal-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f5f4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #be185d;
  font-weight: 700;
}
.cal-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.cal-header {
  display: flex;
  margin-bottom: 12rpx;
}
.cal-hcell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #a8a29e;
  font-weight: 500;
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  gap: 2rpx;
}
.cal-empty {
  width: calc(100% / 7);
}
.cal-day-num {
  font-size: 28rpx;
  color: #44403c;
  font-weight: 500;
}
.cal-today .cal-day-num {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #ec4899, #8b5cf6);
  color: #fff;
  font-weight: 700;
}
.cal-has-record .cal-day-num {
  color: #be185d;
  font-weight: 600;
}
.cal-day-marks {
  display: flex;
  gap: 4rpx;
  margin-top: 2rpx;
  height: 20rpx;
}
.cal-mark { font-size: 18rpx; }
.cal-mark-morning { color: #f59e0b; }
.cal-mark-night { color: #8b5cf6; }
.cal-mark-photo { color: #ec4899; }
.cal-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f4;
  flex-wrap: wrap;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #a8a29e;
}

/* ===== 弹窗 ===== */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 88%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
}
.detail-modal {
  width: 80%;
  max-height: 75vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  border-radius: 100rpx;
  padding: 18rpx 36rpx;
}
.btn-primary {
  background: var(--grad-hero);
  color: #fff;
}
.btn-outline {
  background: #f5f5f4;
  color: #78716c;
}
